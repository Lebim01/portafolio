---
import { getPortfolioContent } from '../data/portfolio';
import type { Locale } from '../i18n/utils';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? Astro.locals.locale ?? 'es';
const { aboutData } = getPortfolioContent(locale);
---

<section
  id="about"
  aria-labelledby="about-heading"
  class="relative py-16 md:py-24"
>
  <div class="section-divider mb-16 md:mb-24" aria-hidden="true"></div>

  <div class="container-shell">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-12 items-start">
      <!-- Left Column: Personal Intro & Philosophy (No heavy boxes) -->
      <div class="lg:col-span-5 lg:sticky lg:top-28" data-reveal>
        <div class="mb-3 inline-flex items-center gap-3 font-mono text-xs font-semibold tracking-[0.2em] text-accent uppercase">
          <span>{aboutData.sectionLabel}</span>
          <span class="h-[1px] w-8 bg-accent/70" aria-hidden="true"></span>
        </div>

        <h2
          id="about-heading"
          class="font-display text-2xl font-bold tracking-tight text-text-primary sm:text-3xl lg:text-[2.15rem] lg:leading-[1.18]"
        >
          {aboutData.heading}
        </h2>

        <p class="mt-4 text-sm leading-relaxed text-text-secondary sm:text-base">
          {aboutData.lead}
        </p>

        <!-- Personal Networking & Travel Note (Clean editorial accent border, not a box) -->
        <p class="mt-5 border-l-2 border-accent/70 pl-4 text-xs sm:text-sm italic leading-relaxed text-text-primary/90">
          {aboutData.personalNote}
        </p>

        <!-- Minimal Inline Tags -->
        <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 pt-2 text-xs font-mono text-text-secondary">
          {
            aboutData.highlights.map((item) => (
              <span class="inline-flex items-center gap-1.5">
                <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
                <span>{item}</span>
              </span>
            ))
          }
        </div>
      </div>

      <!-- Right Column: Compact Chronological Story Timeline (Zero bulky cards) -->
      <div class="lg:col-span-7" data-reveal>
        <ol class="relative border-l border-border-subtle ml-2 sm:ml-3 space-y-7">
          {
            aboutData.milestones.map((item, index) => (
              <li class="group relative pl-6 sm:pl-8">
                <!-- Timeline Node Dot -->
                <span
                  class:list={[
                    'absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full border transition-all duration-300',
                    index === aboutData.milestones.length - 1
                      ? 'border-accent bg-accent shadow-[0_0_10px_rgba(245,158,11,0.7)]'
                      : 'border-accent/70 bg-bg-base group-hover:bg-accent group-hover:scale-125',
                  ]}
                  aria-hidden="true"
                />

                <!-- Stage & Tech Keywords -->
                <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                  <span class="font-mono text-[11px] font-semibold tracking-wider text-accent uppercase">
                    {item.stage}
                  </span>
                  {item.tags.trim() && (
                    <span class="font-mono text-[11px] text-text-muted">
                      {item.tags.trim()}
                    </span>
                  )}
                </div>

                <!-- Milestone Title -->
                <h3 class="mt-1 font-display text-base font-bold text-text-primary transition-colors group-hover:text-accent sm:text-lg">
                  {item.title}
                </h3>

                <!-- Compact Narrative -->
                <p class="mt-1.5 text-xs leading-relaxed text-text-secondary sm:text-sm">
                  {item.description}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
