---
import { getPortfolioContent } from '../data/portfolio';
import type { Locale } from '../i18n/utils';
import { ArrowUpRight, Globe } from '@lucide/astro';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? Astro.locals.locale ?? 'es';
const { aboutData } = getPortfolioContent(locale);
const { lifestyle } = aboutData;
---

<section
  id="about"
  aria-labelledby="about-heading"
  class="relative py-16 md:py-24"
>
  <div class="section-divider mb-16 md:mb-24" aria-hidden="true"></div>

  <div class="container-shell">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-12 items-start">
      <!-- Left Column: Personal Intro & Philosophy (No heavy boxes) -->
      <div class="lg:col-span-5 lg:sticky lg:top-28" data-reveal>
        <div class="mb-3 inline-flex items-center gap-3 font-mono text-xs font-semibold tracking-[0.2em] text-accent uppercase">
          <span>{aboutData.sectionLabel}</span>
          <span class="h-[1px] w-8 bg-accent/70" aria-hidden="true"></span>
        </div>

        <h2
          id="about-heading"
          class="font-display text-2xl font-bold tracking-tight text-text-primary sm:text-3xl lg:text-[2.15rem] lg:leading-[1.18]"
        >
          {aboutData.heading}
        </h2>

        <p class="mt-4 text-sm leading-relaxed text-text-secondary sm:text-base">
          {aboutData.lead}
        </p>

        <!-- Minimal Inline Tags -->
        <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 pt-2 text-xs font-mono text-text-secondary">
          {
            aboutData.highlights.map((item) => (
              <span class="inline-flex items-center gap-1.5">
                <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
                <span>{item}</span>
              </span>
            ))
          }
        </div>
      </div>

      <!-- Right Column: Compact Chronological Story Timeline (Zero bulky cards) -->
      <div class="lg:col-span-7" data-reveal>
        <ol class="relative border-l border-border-subtle ml-2 sm:ml-3 space-y-7">
          {
            aboutData.milestones.map((item, index) => (
              <li class="group relative pl-6 sm:pl-8">
                <!-- Timeline Node Dot -->
                <span
                  class:list={[
                    'absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full border transition-all duration-300',
                    index === aboutData.milestones.length - 1
                      ? 'border-accent bg-accent shadow-[0_0_10px_rgba(245,158,11,0.7)]'
                      : 'border-accent/70 bg-bg-base group-hover:bg-accent group-hover:scale-125',
                  ]}
                  aria-hidden="true"
                />

                <!-- Stage & Tech Keywords -->
                <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                  <span class="font-mono text-[11px] font-semibold tracking-wider text-accent uppercase">
                    {item.stage}
                  </span>
                  {item.tags.trim() && (
                    <span class="font-mono text-[11px] text-text-muted">
                      {item.tags.trim()}
                    </span>
                  )}
                </div>

                <!-- Milestone Title -->
                <h3 class="mt-1 font-display text-base font-bold text-text-primary transition-colors group-hover:text-accent sm:text-lg">
                  {item.title}
                </h3>

                <!-- Compact Narrative -->
                <p class="mt-1.5 text-xs leading-relaxed text-text-secondary sm:text-sm">
                  {item.description}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <!-- Ultra-Compact Lifestyle, Networking & Speaking Strip -->
    <div
      data-reveal
      class="mt-12 rounded-2xl border border-border-subtle/80 bg-[#11161D] px-5 py-5 sm:px-6"
    >
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-center">
        <!-- Left: Eyebrow, Short Note & Flag-Only Strip -->
        <div class="lg:col-span-5">
          <div class="inline-flex items-center gap-2 font-mono text-[10px] font-semibold tracking-[0.18em] text-accent uppercase">
            <Globe class="h-3.5 w-3.5 text-accent" aria-hidden="true" />
            <span>{lifestyle.eyebrow}</span>
          </div>
          <p class="mt-1.5 text-xs leading-relaxed text-text-secondary">
            {lifestyle.summary}
          </p>

          <!-- Flags Only (Zero text labels, crisp SVG flags with tooltip) -->
          <div
            class="mt-3.5 flex flex-wrap items-center gap-2"
            aria-label={lifestyle.countriesLabel}
          >
            {lifestyle.countries.map((country) => (
              <span
                title={country.name}
                aria-label={country.name}
                class="inline-flex h-5 w-7 shrink-0 overflow-hidden rounded-[4px] border border-white/15 bg-bg-base shadow-sm transition-transform duration-200 hover:scale-110 hover:border-accent/60"
              >
                <img
                  src={`https://flagcdn.com/${country.code.toLowerCase()}.svg`}
                  alt={
                    locale === 'en'
                      ? `Flag of ${country.name} — International Networking & Business`
                      : `Bandera de ${country.name} — Networking y Negocios Internacionales`
                  }
                  title={country.name}
                  width="28"
                  height="20"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              </span>
            ))}
          </div>
        </div>

        <!-- Right: Uniform 2x2 Grid of Conferences & Events -->
        <div class="lg:col-span-7 lg:border-l lg:border-border-subtle/60 lg:pl-6">
          <div class="mb-2.5 flex flex-wrap items-center justify-between gap-2">
            <span class="font-mono text-[10px] font-semibold tracking-[0.16em] text-text-secondary uppercase">
              {lifestyle.eventsLabel}
            </span>
            <span class="font-mono text-[10px] text-text-muted italic">
              {lifestyle.moreLabel}
            </span>
          </div>

          <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-2">
            {lifestyle.events.map((ev) => (
              <a
                href={ev.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center justify-between gap-3 rounded-xl border border-white/10 bg-bg-base/80 px-3.5 py-2.5 transition-all duration-200 hover:border-accent/50 hover:bg-surface"
              >
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2">
                    <span class="truncate font-display text-xs font-bold text-white transition-colors group-hover:text-accent">
                      {ev.name}
                    </span>
                    <span
                      class:list={[
                        'shrink-0 rounded-full px-1.5 py-0.5 font-mono text-[9px] font-semibold uppercase leading-none',
                        ev.highlight
                          ? 'bg-accent/20 text-accent border border-accent/40'
                          : 'border border-white/12 bg-white/5 text-zinc-300',
                      ]}
                    >
                      {ev.role}
                    </span>
                  </div>
                  <p class="mt-1 truncate font-mono text-[10px] text-text-secondary">
                    {ev.detail}
                  </p>
                </div>
                <ArrowUpRight
                  class="h-3.5 w-3.5 shrink-0 text-text-muted transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent"
                  aria-hidden="true"
                />
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
