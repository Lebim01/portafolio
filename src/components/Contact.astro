---
import { getPortfolioContent } from '../data/portfolio';
import type { Locale } from '../i18n/utils';
import {
  Mail,
  MapPin,
  Send,
  ShieldCheck,
  X,
} from '@lucide/astro';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? Astro.locals.locale ?? 'es';
const { siteMetadata, contactSection } = getPortfolioContent(locale);
const { form: f } = contactSection;
const contactEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || '/api/contact';
const closeModalLabel = locale === 'en' ? 'Close contact modal' : 'Cerrar ventana de contacto';
---

<!-- Emergent Contact Popup Modal -->
<div
  id="contact-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="contact-heading"
  aria-hidden="true"
  class="fixed inset-0 z-[90] hidden items-center justify-center p-4 sm:p-6 overflow-y-auto"
>
  <!-- Backdrop -->
  <div
    id="contact-modal-backdrop"
    class="fixed inset-0 bg-bg-base/80 backdrop-blur-md transition-opacity duration-200 opacity-0"
    aria-hidden="true"
  ></div>

  <!-- Modal Dialog Surface -->
  <div
    id="contact-modal-panel"
    class="spotlight-card corner-amber-glow relative z-10 my-auto w-full max-w-2xl scale-95 opacity-0 shadow-[0_24px_64px_rgba(0,0,0,0.85)] transition-all duration-200"
  >
    <div class="relative z-10 p-6 sm:p-8">
      <!-- Modal Header -->
      <div class="flex items-start justify-between gap-4 border-b border-border-subtle/80 pb-4">
        <div>
          <div class="mb-1.5 inline-flex items-center gap-2 font-mono text-[11px] font-semibold tracking-[0.2em] text-accent uppercase">
            <span>{contactSection.eyebrow}</span>
            <span class="h-[1px] w-6 bg-accent/70" aria-hidden="true"></span>
          </div>
          <h2
            id="contact-heading"
            class="font-display text-2xl font-bold tracking-tight text-text-primary sm:text-3xl"
          >
            {contactSection.heading}
          </h2>
          <p class="mt-1.5 text-xs leading-relaxed text-text-secondary sm:text-sm">
            {contactSection.subtitle}
          </p>
        </div>

        <button
          id="contact-modal-close"
          type="button"
          class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-[20px] border border-border-subtle bg-bg-base/80 text-text-secondary transition-colors hover:border-accent/60 hover:text-accent"
          aria-label={closeModalLabel}
        >
          <X class="h-4 w-4" aria-hidden="true" />
        </button>
      </div>

      <!-- Compact Direct Info Strip -->
      <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 rounded-xl border border-border-subtle/70 bg-bg-base/60 px-4 py-2.5 text-xs">
        <a
          href={`mailto:${siteMetadata.email}`}
          class="inline-flex items-center gap-2 font-mono text-text-primary transition-colors hover:text-accent"
        >
          <Mail class="h-3.5 w-3.5 text-accent" aria-hidden="true" />
          <span>{siteMetadata.email}</span>
        </a>
        <span class="inline-flex items-center gap-2 text-text-secondary">
          <MapPin class="h-3.5 w-3.5 text-accent" aria-hidden="true" />
          <span>{siteMetadata.location}</span>
        </span>
      </div>

      <!-- Contact Form -->
      <form
        id="contact-form"
        data-endpoint={contactEndpoint}
        data-recipient={siteMetadata.email}
        data-i18n={JSON.stringify({
          processingLabel: f.processingLabel,
          copyBtnLabel: f.copyBtnLabel,
          copiedBtnLabel: f.copiedBtnLabel,
          validationAlert: f.validationAlert,
          copyValidationAlert: f.copyValidationAlert,
          copySuccessInfo: f.copySuccessInfo,
          copyErrorAlert: f.copyErrorAlert,
          serverSuccessAlert: f.serverSuccessAlert,
          serverErrorAlert: f.serverErrorAlert,
          mailtoOpeningInfo: f.mailtoOpeningInfo,
          mailSubjectPrefix: f.mailSubjectPrefix,
          mailLabels: f.mailLabels,
        })}
        novalidate
        class="mt-5 space-y-4"
      >
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <!-- Name Field -->
          <div>
            <label
              for="contact-name"
              class="block font-mono text-xs font-medium text-text-primary mb-1.5"
            >
              {f.nameLabel} <span class="text-accent" aria-hidden="true">*</span>
            </label>
            <input
              id="contact-name"
              name="name"
              type="text"
              required
              minlength="2"
              autocomplete="name"
              placeholder={f.namePlaceholder}
              aria-describedby="error-name"
              class="w-full rounded-xl border border-border-subtle bg-bg-base/90 px-3.5 py-2.5 text-sm text-text-primary placeholder:text-text-muted transition-colors focus:border-accent focus:outline-none"
            />
            <p
              id="error-name"
              class="mt-1 hidden text-xs text-amber-400"
              role="alert"
            >
              {f.nameError}
            </p>
          </div>

          <!-- Email Field -->
          <div>
            <label
              for="contact-email"
              class="block font-mono text-xs font-medium text-text-primary mb-1.5"
            >
              {f.emailLabel} <span class="text-accent" aria-hidden="true">*</span>
            </label>
            <input
              id="contact-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder={f.emailPlaceholder}
              aria-describedby="error-email"
              class="w-full rounded-xl border border-border-subtle bg-bg-base/90 px-3.5 py-2.5 text-sm text-text-primary placeholder:text-text-muted transition-colors focus:border-accent focus:outline-none"
            />
            <p
              id="error-email"
              class="mt-1 hidden text-xs text-amber-400"
              role="alert"
            >
              {f.emailError}
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <!-- Project Category Select -->
          <div>
            <label
              for="contact-type"
              class="block font-mono text-xs font-medium text-text-primary mb-1.5"
            >
              {f.typeLabel} <span class="text-accent" aria-hidden="true">*</span>
            </label>
            <select
              id="contact-type"
              name="projectType"
              required
              aria-describedby="error-type"
              class="w-full rounded-xl border border-border-subtle bg-bg-base/90 px-3.5 py-2.5 text-sm text-text-primary transition-colors focus:border-accent focus:outline-none"
            >
              <option value="">{f.typePlaceholder}</option>
              {f.typeOptions.map((opt) => <option value={opt}>{opt}</option>)}
            </select>
            <p
              id="error-type"
              class="mt-1 hidden text-xs text-amber-400"
              role="alert"
            >
              {f.typeError}
            </p>
          </div>

          <!-- Engagement Scope -->
          <div>
            <label
              for="contact-scope"
              class="block font-mono text-xs font-medium text-text-primary mb-1.5"
            >
              {f.scopeLabel}
            </label>
            <select
              id="contact-scope"
              name="scope"
              class="w-full rounded-xl border border-border-subtle bg-bg-base/90 px-3.5 py-2.5 text-sm text-text-primary transition-colors focus:border-accent focus:outline-none"
            >
              {f.scopeOptions.map((opt) => <option value={opt}>{opt}</option>)}
            </select>
          </div>
        </div>

        <!-- Message Textarea -->
        <div>
          <label
            for="contact-message"
            class="block font-mono text-xs font-medium text-text-primary mb-1.5"
          >
            {f.messageLabel} <span class="text-accent" aria-hidden="true">*</span>
          </label>
          <textarea
            id="contact-message"
            name="message"
            rows="3"
            required
            minlength="15"
            placeholder={f.messagePlaceholder}
            aria-describedby="error-message"
            class="w-full resize-y rounded-xl border border-border-subtle bg-bg-base/90 px-3.5 py-2.5 text-sm text-text-primary placeholder:text-text-muted transition-colors focus:border-accent focus:outline-none"
          ></textarea>
          <p
            id="error-message"
            class="mt-1 hidden text-xs text-amber-400"
            role="alert"
          >
            {f.messageError}
          </p>
        </div>

        <!-- Anti-Spam Honeypot (Hidden from humans) -->
        <div class="hidden" aria-hidden="true">
          <label for="contact-website">Website</label>
          <input
            id="contact-website"
            name="website"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <!-- Live Status Banner -->
        <div
          id="contact-status"
          class="hidden rounded-xl border p-3.5 text-xs leading-relaxed"
          role="status"
          aria-live="polite"
        ></div>

        <!-- Direct Submit & Security Notice -->
        <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
          <button
            id="contact-submit-btn"
            type="submit"
            class="group inline-flex items-center justify-center gap-2 rounded-[20px] bg-accent px-5 py-2.5 text-xs font-bold tracking-wider text-bg-base uppercase shadow-[0_0_25px_rgba(245,158,11,0.3)] transition-all duration-200 hover:bg-accent-hover hover:shadow-[0_0_32px_rgba(245,158,11,0.45)] active:scale-[0.98] cursor-pointer disabled:cursor-not-allowed disabled:opacity-60"
          >
            <span id="contact-submit-label">
              {f.submitEndpointLabel}
            </span>
            <Send
              class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5"
              aria-hidden="true"
            />
          </button>

          <p class="flex items-center gap-2 text-[11px] text-text-muted">
            <ShieldCheck class="h-3.5 w-3.5 shrink-0 text-accent/80" aria-hidden="true" />
            <span>{f.endpointDisclaimer}</span>
          </p>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const modal = document.getElementById('contact-modal');
    const backdrop = document.getElementById('contact-modal-backdrop');
    const panel = document.getElementById('contact-modal-panel');
    const closeBtn = document.getElementById('contact-modal-close');

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusBox = document.getElementById('contact-status');
  const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;
  const submitLabel = document.getElementById('contact-submit-label');

  const nameInput = document.getElementById('contact-name') as HTMLInputElement | null;
  const emailInput = document.getElementById('contact-email') as HTMLInputElement | null;
  const typeSelect = document.getElementById('contact-type') as HTMLSelectElement | null;
  const scopeSelect = document.getElementById('contact-scope') as HTMLSelectElement | null;
  const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement | null;
  const websiteInput = document.getElementById('contact-website') as HTMLInputElement | null;

  const formLoadedAt = Date.now();
  let lastFocusedElement: HTMLElement | null = null;

  const openContactModal = (triggerEl?: HTMLElement | null) => {
    if (!modal || !backdrop || !panel) return;
    lastFocusedElement = triggerEl ?? (document.activeElement as HTMLElement | null);

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';

    requestAnimationFrame(() => {
      backdrop.classList.remove('opacity-0');
      backdrop.classList.add('opacity-100');
      panel.classList.remove('scale-95', 'opacity-0');
      panel.classList.add('scale-100', 'opacity-100');
      nameInput?.focus();
    });
  };

  const closeContactModal = () => {
    if (!modal || !backdrop || !panel) return;
    backdrop.classList.remove('opacity-100');
    backdrop.classList.add('opacity-0');
    panel.classList.remove('scale-100', 'opacity-100');
    panel.classList.add('scale-95', 'opacity-0');

    if (window.location.hash === '#contact') {
      history.replaceState(null, '', window.location.pathname + window.location.search);
    }

    setTimeout(() => {
      modal.classList.remove('flex');
      modal.classList.add('hidden');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      lastFocusedElement?.focus();
    }, 180);
  };

  // Intercept all links pointing to #contact to open the popup modal
  document.querySelectorAll<HTMLAnchorElement>('a[href="#contact"], [data-open-contact]').forEach((trigger) => {
    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      openContactModal(trigger);
    });
  });

  // Open automatically if URL hash is #contact
  if (window.location.hash === '#contact') {
    openContactModal();
  }

  closeBtn?.addEventListener('click', closeContactModal);
  backdrop?.addEventListener('click', closeContactModal);

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && modal?.getAttribute('aria-hidden') === 'false') {
      closeContactModal();
    }
  });

  const i18nData = form?.dataset.i18n ? JSON.parse(form.dataset.i18n) : null;

  const setFieldError = (
    field: HTMLElement | null,
    errorId: string,
    hasError: boolean
  ) => {
    const errorEl = document.getElementById(errorId);
    if (!field || !errorEl) return;
    field.setAttribute('aria-invalid', String(hasError));
    field.classList.toggle('border-amber-500', hasError);
    errorEl.classList.toggle('hidden', !hasError);
  };

  const validateForm = (): boolean => {
    let valid = true;

    const nameVal = nameInput?.value.trim() ?? '';
    const isNameInvalid = nameVal.length < 2;
    setFieldError(nameInput, 'error-name', isNameInvalid);
    if (isNameInvalid) valid = false;

    const emailVal = emailInput?.value.trim() ?? '';
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const isEmailInvalid = !emailRegex.test(emailVal);
    setFieldError(emailInput, 'error-email', isEmailInvalid);
    if (isEmailInvalid) valid = false;

    const typeVal = typeSelect?.value.trim() ?? '';
    const isTypeInvalid = typeVal.length === 0;
    setFieldError(typeSelect, 'error-type', isTypeInvalid);
    if (isTypeInvalid) valid = false;

    const msgVal = messageInput?.value.trim() ?? '';
    const isMsgInvalid = msgVal.length < 15;
    setFieldError(messageInput, 'error-message', isMsgInvalid);
    if (isMsgInvalid) valid = false;

    return valid;
  };

  const showStatus = (type: 'error' | 'info' | 'success', message: string) => {
    if (!statusBox) return;
    statusBox.classList.remove(
      'hidden',
      'border-amber-500/40',
      'bg-amber-500/10',
      'text-amber-300',
      'border-emerald-500/40',
      'bg-emerald-500/10',
      'text-emerald-300',
      'border-accent/40',
      'bg-accent/10',
      'text-text-primary'
    );

    if (type === 'error') {
      statusBox.classList.add('border-amber-500/40', 'bg-amber-500/10', 'text-amber-300');
    } else if (type === 'success') {
      statusBox.classList.add('border-emerald-500/40', 'bg-emerald-500/10', 'text-emerald-300');
    } else {
      statusBox.classList.add('border-accent/40', 'bg-accent/10', 'text-text-primary');
    }
    statusBox.textContent = message;
  };

  const buildStructuredPayload = () => {
    const name = nameInput?.value.trim() ?? '';
    const email = emailInput?.value.trim() ?? '';
    const projectType = typeSelect?.value.trim() ?? '';
    const scope = scopeSelect?.value.trim() ?? '';
    const message = messageInput?.value.trim() ?? '';

    const labels = i18nData?.mailLabels ?? {
      to: 'To',
      subject: 'Subject',
      name: 'Name',
      email: 'Email',
      specialty: 'Specialty',
      scope: 'Scope',
      context: 'Message',
    };
    const prefix = i18nData?.mailSubjectPrefix ?? '[Portfolio]';

    const subject = `${prefix} ${projectType} — ${name}`;
    const body = [
      `${labels.name}: ${name}`,
      `${labels.email}: ${email}`,
      `${labels.specialty}: ${projectType}`,
      `${labels.scope}: ${scope}`,
      '',
      `${labels.context}:`,
      message,
    ].join('\n');

    return { name, email, projectType, scope, message, subject, body, labels };
  };

  [
    [nameInput, 'error-name'],
    [emailInput, 'error-email'],
    [typeSelect, 'error-type'],
    [messageInput, 'error-message'],
  ].forEach(([el, errId]) => {
    (el as HTMLElement | null)?.addEventListener('input', () => {
      setFieldError(el as HTMLElement | null, errId as string, false);
    });
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!validateForm()) {
      showStatus(
        'error',
        i18nData?.validationAlert ?? 'Please review the fields above.'
      );
      return;
    }

    const endpoint = form.dataset.endpoint?.trim() || '/api/contact';
    const recipient = form.dataset.recipient?.trim() ?? 'contacto@victoralvarez.dev';
    const payload = buildStructuredPayload();
    const locale = document.documentElement.lang === 'en' ? 'en' : 'es';

    if (submitBtn) submitBtn.disabled = true;
    const originalLabel = submitLabel?.textContent ?? 'Send';
    if (submitLabel) {
      submitLabel.textContent = i18nData?.processingLabel ?? 'Sending...';
    }

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          ...payload,
          locale,
          website: websiteInput?.value ?? '',
          elapsedMs: Date.now() - formLoadedAt,
        }),
      });

      const result = await response.json().catch(() => null);

      if (!response.ok || (result && result.ok === false)) {
        throw new Error(result?.message || `HTTP ${response.status}`);
      }

      const refSuffix = result?.id ? ` (Ref: ${result.id})` : '';
      showStatus(
        'success',
        `${i18nData?.serverSuccessAlert ?? 'Message sent and confirmed.'}${refSuffix}`
      );
      form.reset();
    } catch {
      showStatus(
        'error',
        `${i18nData?.serverErrorAlert ?? 'Server error. Email:'} ${recipient}.`
      );
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      if (submitLabel) submitLabel.textContent = originalLabel;
    }
  });
  });
</script>
