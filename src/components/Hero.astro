---
import { getPortfolioContent } from '../data/portfolio';
import type { Locale } from '../i18n/utils';
import {
  ArrowRight,
  Layers,
} from '@lucide/astro';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? Astro.locals.locale ?? 'es';
const { heroData } = getPortfolioContent(locale);
---

<section
  id="hero"
  aria-labelledby="hero-heading"
  class="relative overflow-hidden pt-6 pb-20 md:pt-12 md:pb-28 lg:pt-16 lg:pb-32"
>
  <!-- Background Radial Illumination & Subtle Grid -->
  <div
    data-hero-bg
    class="pointer-events-none absolute inset-0 -z-10"
    aria-hidden="true"
  >
    <div class="tech-grid-bg absolute inset-0 opacity-75"></div>
    <!-- Left soft radial glow -->
    <div
      class="absolute -top-24 -left-24 h-[420px] w-[420px] rounded-full bg-[radial-gradient(circle,rgba(245,158,11,0.10)_0%,transparent_70%)]"
    ></div>
    <!-- Right portrait radial glow -->
    <div
      class="absolute top-1/2 right-[4%] -translate-y-1/2 h-[480px] w-[480px] lg:h-[620px] lg:w-[620px] rounded-full bg-[radial-gradient(circle,rgba(245,158,11,0.17)_0%,rgba(245,158,11,0.04)_45%,transparent_72%)]"
    ></div>
  </div>

  <div class="container-shell">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-8">
      <!-- Left Column: Typography, CTAs & Status -->
      <div class="lg:col-span-7 xl:col-span-6">
        <!-- Eyebrow with flanking lines -->
        <div
          data-hero-eyebrow
          class="mb-4 inline-flex items-center gap-3 font-mono text-xs font-medium tracking-[0.2em] text-accent uppercase"
        >
          <span class="h-[1px] w-6 bg-accent/70" aria-hidden="true"></span>
          <span>{heroData.eyebrow}</span>
          <span class="h-[1px] w-6 bg-accent/70" aria-hidden="true"></span>
        </div>

        <!-- Main Heading -->
        <h1
          id="hero-heading"
          data-hero-title
          class="font-display text-4xl font-bold tracking-tight text-text-primary sm:text-5xl md:text-6xl lg:text-[4.15rem] lg:leading-[1.06]"
        >
          {heroData.firstName}{' '}
          <span class="text-accent">{heroData.lastName}</span>
        </h1>

        <!-- Subtitle with subtle amber bar indicator -->
        <p
          data-hero-subtitle
          class="mt-4 flex items-center gap-2.5 font-display text-lg font-medium text-text-primary/95 sm:text-xl md:text-2xl"
        >
          <span>{heroData.role}</span>
          <span
            class="inline-block h-6 w-[2.5px] bg-accent animate-pulse"
            aria-hidden="true"
          ></span>
        </p>

        <!-- Description -->
        <p
          data-hero-desc
          class="mt-5 max-w-xl text-base leading-relaxed text-text-secondary sm:text-[1.0625rem]"
        >
          {heroData.summary}
        </p>

        <!-- Primary & Secondary CTAs -->
        <div
          data-hero-ctas
          class="mt-8 flex flex-wrap items-center gap-4"
        >
          <a
            href={heroData.primaryCta.href}
            class="group inline-flex min-h-[48px] items-center justify-center gap-2.5 rounded-[20px] bg-accent px-7 py-3.5 text-xs font-bold tracking-wider text-bg-base uppercase shadow-[0_0_28px_rgba(245,158,11,0.32)] transition-all duration-200 hover:bg-accent-hover hover:shadow-[0_0_36px_rgba(245,158,11,0.48)] active:scale-[0.98]"
          >
            <span>{heroData.primaryCta.label}</span>
            <ArrowRight
              class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
              aria-hidden="true"
            />
          </a>

          <a
            href={heroData.secondaryCta.href}
            class="group inline-flex min-h-[48px] items-center justify-center gap-2.5 rounded-[20px] border border-border-subtle bg-surface/90 px-6 py-3.5 text-xs font-semibold tracking-wider text-text-primary uppercase transition-all duration-200 hover:border-accent/60 hover:bg-surface-elevated active:scale-[0.98]"
          >
            <span>{heroData.secondaryCta.label}</span>
            <Layers
              class="h-4 w-4 text-accent transition-transform duration-200 group-hover:scale-110"
              aria-hidden="true"
            />
          </a>
        </div>
      </div>

      <!-- Right Column: Visual Stage, Technological Rings, Integrated Portrait Placeholder & Floating Badges -->
      <div class="lg:col-span-5 xl:col-span-6">
        <div
          data-hero-visual
          class="relative mx-auto flex max-w-[460px] lg:max-w-[540px] items-center justify-center pt-4 pb-6"
        >
          <!-- Concentric Technological Rings Behind Portrait -->
          <div
            class="ring-ambient pointer-events-none absolute inset-0 flex items-center justify-center"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 520 520"
              class="h-full w-full max-h-[480px] max-w-[480px]"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <defs>
                <radialGradient id="heroRingGlow" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#F59E0B" stop-opacity="0.22" />
                  <stop offset="65%" stop-color="#F59E0B" stop-opacity="0.06" />
                  <stop offset="100%" stop-color="#0A0E13" stop-opacity="0" />
                </radialGradient>
                <linearGradient id="amberArc" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#FBBF24" stop-opacity="0.95" />
                  <stop offset="50%" stop-color="#F59E0B" stop-opacity="0.45" />
                  <stop offset="100%" stop-color="#292F39" stop-opacity="0.1" />
                </linearGradient>
                <linearGradient id="amberArcReverse" x1="100%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" stop-color="#F59E0B" stop-opacity="0.8" />
                  <stop offset="60%" stop-color="#292F39" stop-opacity="0.3" />
                  <stop offset="100%" stop-color="#0A0E13" stop-opacity="0" />
                </linearGradient>
              </defs>

              <!-- Core ambient disc -->
              <circle cx="260" cy="260" r="210" fill="url(#heroRingGlow)" />

              <!-- Outer precision dashed ring -->
              <circle
                cx="260"
                cy="260"
                r="232"
                stroke="#292F39"
                stroke-width="1"
                stroke-dasharray="4 8"
              />

              <!-- Primary luminous amber ring -->
              <circle
                cx="260"
                cy="260"
                r="192"
                stroke="url(#amberArc)"
                stroke-width="2.25"
              />

              <!-- Secondary inner ring -->
              <circle
                cx="260"
                cy="260"
                r="158"
                stroke="url(#amberArcReverse)"
                stroke-width="1.25"
                stroke-dasharray="18 10"
              />

              <!-- Luminous orbital nodes on the ring -->
              <circle cx="94" cy="164" r="4.5" fill="#F59E0B" />
              <circle cx="94" cy="164" r="10" stroke="#F59E0B" stroke-opacity="0.35" />
              <circle cx="426" cy="164" r="4" fill="#FBBF24" />
              <circle cx="412" cy="376" r="3.5" fill="#F59E0B" />
              <circle cx="114" cy="382" r="3" fill="#F59E0B" fill-opacity="0.7" />
            </svg>
          </div>

          <!-- Portrait Integration Container (Seamless bottom fade into #0A0E13 background) -->
          <div
            class="relative z-10 flex w-full max-w-[350px] sm:max-w-[380px] flex-col items-center"
          >
            <div
              class="relative flex aspect-[4/4.6] w-full flex-col items-center justify-end overflow-hidden rounded-t-full"
              style="mask-image: linear-gradient(to bottom, #000 72%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent 100%);"
            >
              <!-- Rim light aura behind head & shoulders -->
              <div
                class="pointer-events-none absolute top-10 h-56 w-56 rounded-full bg-[radial-gradient(circle,rgba(245,158,11,0.28)_0%,transparent_70%)]"
                aria-hidden="true"
              ></div>

              <!-- High-craft developer silhouette + architectural wireframe -->
              <svg
                viewBox="0 0 360 410"
                class="relative z-10 h-full w-full select-none"
                role="img"
                aria-label={heroData.portraitPlaceholder.svgAriaLabel}
              >
                <defs>
                  <linearGradient id="silhouetteGrad" x1="50%" y1="0%" x2="50%" y2="100%">
                    <stop offset="0%" stop-color="#232A36" />
                    <stop offset="55%" stop-color="#151A21" />
                    <stop offset="100%" stop-color="#0A0E13" />
                  </linearGradient>
                  <linearGradient id="rimStroke" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#FBBF24" stop-opacity="0.85" />
                    <stop offset="45%" stop-color="#F59E0B" stop-opacity="0.4" />
                    <stop offset="100%" stop-color="#292F39" stop-opacity="0.2" />
                  </linearGradient>
                </defs>

                <line x1="180" y1="24" x2="180" y2="380" stroke="#292F39" stroke-width="1" stroke-dasharray="3 6" />
                <line x1="40" y1="145" x2="320" y2="145" stroke="#292F39" stroke-width="1" stroke-dasharray="3 6" />

                <path
                  d="M42 405 C46 305, 95 262, 180 262 C265 262, 314 305, 318 405 Z"
                  fill="url(#silhouetteGrad)"
                  stroke="url(#rimStroke)"
                  stroke-width="1.75"
                />
                <path
                  d="M132 266 C148 308, 212 308, 228 266"
                  fill="none"
                  stroke="#292F39"
                  stroke-width="1.5"
                />
                <path
                  d="M110 315 L145 400 M250 315 L215 400"
                  stroke="#292F39"
                  stroke-width="1.25"
                />

                <path
                  d="M156 225 L156 266 L204 266 L204 225 Z"
                  fill="#181E27"
                />
                <rect
                  x="132"
                  y="92"
                  width="96"
                  height="132"
                  rx="46"
                  fill="url(#silhouetteGrad)"
                  stroke="url(#rimStroke)"
                  stroke-width="1.75"
                />

                <rect
                  x="144"
                  y="144"
                  width="30"
                  height="18"
                  rx="4"
                  fill="#0A0E13"
                  fill-opacity="0.55"
                  stroke="#F59E0B"
                  stroke-width="1.4"
                  stroke-opacity="0.8"
                />
                <rect
                  x="186"
                  y="144"
                  width="30"
                  height="18"
                  rx="4"
                  fill="#0A0E13"
                  fill-opacity="0.55"
                  stroke="#F59E0B"
                  stroke-width="1.4"
                  stroke-opacity="0.8"
                />
                <line
                  x1="174"
                  y1="152"
                  x2="186"
                  y2="152"
                  stroke="#F59E0B"
                  stroke-width="1.4"
                  stroke-opacity="0.8"
                />
              </svg>
            </div>

            <!-- Clearly Identifiable Portrait Placeholder Caption -->
            <div
              class="-mt-8 relative z-20 flex items-center gap-2.5 rounded-full border border-accent/35 bg-surface/95 px-4 py-1.5 shadow-[0_8px_24px_rgba(0,0,0,0.65)] backdrop-blur-md"
            >
              <span class="h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
              <span class="font-mono text-[11px] font-medium tracking-wider text-text-primary uppercase">
                {heroData.portraitPlaceholder.label}
              </span>
              <span class="hidden sm:inline font-mono text-[10px] text-text-secondary">
                · {heroData.portraitPlaceholder.sublabel}
              </span>
            </div>
          </div>

          <!-- Floating Technology Badges (Desktop) -->
          <div class="hidden sm:block" aria-label="Primary technologies">
            {
              heroData.floatingBadges.map((badge) => (
                <div
                  data-hero-badge
                  class:list={[
                    'absolute z-20 flex items-center gap-2.5 rounded-xl border border-border-subtle bg-surface/95 px-3.5 py-2 shadow-[0_10px_28px_rgba(0,0,0,0.55)] backdrop-blur-md transition-colors duration-200 hover:border-accent/60',
                    badge.positionClass,
                    badge.delayClass,
                  ]}
                >
                  <span
                    class="flex h-6 w-6 items-center justify-center rounded-md text-xs font-bold"
                    style={`background-color: ${badge.accentColor}20; color: ${badge.accentColor}; border: 1px solid ${badge.accentColor}45;`}
                    aria-hidden="true"
                  >
                    ●
                  </span>
                  <div class="flex flex-col">
                    <span class="font-display text-xs font-semibold text-text-primary leading-tight">
                      {badge.name}
                    </span>
                    <span class="font-mono text-[10px] text-text-secondary leading-tight">
                      {badge.category}
                    </span>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Mobile-Intentional Simplified Badges Row -->
        <div
          class="mt-2 grid grid-cols-2 gap-2.5 sm:hidden"
          aria-label="Primary technologies"
        >
          {
            heroData.floatingBadges.map((badge) => (
              <div class="flex items-center gap-2 rounded-lg border border-border-subtle bg-surface px-3 py-2">
                <span
                  class="h-2 w-2 shrink-0 rounded-full"
                  style={`background-color: ${badge.accentColor};`}
                  aria-hidden="true"
                />
                <div class="min-w-0">
                  <p class="truncate font-display text-xs font-semibold text-text-primary">
                    {badge.name}
                  </p>
                  <p class="truncate font-mono text-[10px] text-text-secondary">
                    {badge.category}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
