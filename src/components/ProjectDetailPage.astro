---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import Contact from './Contact.astro';
import { getPortfolioContent, type ProjectItem } from '../data/portfolio';
import type { Locale } from '../i18n/utils';
import {
  ArrowLeft,
  ArrowUpRight,
  Calendar,
  ChevronLeft,
  ChevronRight,
} from '@lucide/astro';

interface Props {
  locale: Locale;
  project: ProjectItem;
}

const { locale, project } = Astro.props;
const { siteMetadata, projectsSection, servicesSection } = getPortfolioContent(locale);

const tagLabelMap = new Map(
  servicesSection.tags.map((tag) => [tag.id, tag]),
);

const allProjectTags = project.industryTags
  .map((id) => tagLabelMap.get(id))
  .filter(Boolean);

const backHref = locale === 'en' ? '/en#projects' : '/#projects';
const backLabel = locale === 'en' ? 'Back to projects' : 'Volver a proyectos';
const otherProjectsLabel = locale === 'en' ? 'Other projects' : 'Otros proyectos';
const getProjectUrl = (id: string) =>
  locale === 'en' ? `/en/projects/${id}` : `/proyectos/${id}`;

const otherProjects = projectsSection.items
  .filter((item) => item.id !== project.id)
  .slice(0, 3);

const siteOrigin = (Astro.site ?? new URL('https://victoralvarez.dev')).toString();
const canonicalPath = getProjectUrl(project.id);
const alternateEsPath = `/proyectos/${project.id}`;
const alternateEnPath = `/en/projects/${project.id}`;
const pageKeywords = [
  ...allProjectTags.map((t) => t!.label),
  ...project.stack,
  project.category,
];

const detailJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      '@id': new URL(canonicalPath, siteOrigin).toString(),
      name: project.title,
      applicationCategory: project.category,
      description: project.seoDescription,
      abstract: project.summary,
      image: {
        '@type': 'ImageObject',
        url: new URL(project.image, siteOrigin).toString(),
        caption: project.imageAlt,
      },
      screenshot: (project.gallery ?? []).map((g) => ({
        '@type': 'ImageObject',
        url: new URL(g.src, siteOrigin).toString(),
        name: g.title,
        caption: g.alt,
      })),
      author: {
        '@type': 'Person',
        name: 'Victor Alvarez',
        jobTitle: project.role,
      },
      featureList: project.highlights,
      keywords: pageKeywords.join(', '),
      operatingSystem: 'Web, Cloud, Distributed Infrastructure',
      inLanguage: locale,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: siteMetadata.brandName,
          item: new URL(locale === 'en' ? '/en' : '/', siteOrigin).toString(),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: project.title,
          item: new URL(canonicalPath, siteOrigin).toString(),
        },
      ],
    },
  ],
};
---

<Layout
  locale={locale}
  title={`${project.title} — ${siteMetadata.brandName}`}
  description={project.seoDescription}
  canonicalPath={canonicalPath}
  alternateEsPath={alternateEsPath}
  alternateEnPath={alternateEnPath}
  ogImage={project.image}
  ogImageAlt={project.imageAlt}
  ogType="article"
  keywords={pageKeywords}
  structuredData={detailJsonLd}
>
  <Navbar locale={locale} />

  <main id="main-content" class="pb-24 md:pb-32">
    <article class="mx-auto max-w-4xl px-5 pt-6 sm:px-8">
      <!-- Top Back Link & Date -->
      <div class="flex flex-wrap items-center justify-between gap-3 pb-6">
        <a
          href={backHref}
          class="inline-flex items-center gap-2 rounded-[20px] border border-border-subtle bg-surface/70 px-3.5 py-1.5 font-mono text-xs font-medium text-text-secondary transition-colors hover:border-accent/60 hover:text-accent"
        >
          <ArrowLeft class="h-3.5 w-3.5 text-accent" aria-hidden="true" />
          <span>{backLabel}</span>
        </a>

        <div class="flex flex-wrap items-center gap-2.5">
          {project.featured && (
            <span class="inline-flex items-center gap-1.5 rounded-[20px] border border-accent/60 bg-accent/15 px-2.5 py-0.5 font-mono text-[10px] font-semibold tracking-wider text-accent uppercase">
              <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
              <span>{locale === 'en' ? 'Featured' : 'Destacado'}</span>
            </span>
          )}
          <span class="rounded-[20px] border border-accent/35 bg-accent/10 px-2.5 py-0.5 font-mono text-[11px] font-medium text-accent">
            {project.role}
          </span>
          <span
            transition:name={`project-date-${project.id}`}
            class="inline-flex items-center gap-1.5 font-mono text-xs text-text-secondary"
          >
            <Calendar class="h-3.5 w-3.5 text-accent" aria-hidden="true" />
            <span>{project.dateRange}</span>
          </span>
          {project.liveUrl && (
            <a
              href={project.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 rounded-[20px] border border-border-subtle bg-surface/80 px-2.5 py-0.5 font-mono text-[11px] font-medium text-text-primary transition-colors hover:border-accent hover:text-accent"
            >
              <span>{locale === 'en' ? 'Visit site' : 'Ver sitio'}</span>
              <ArrowUpRight class="h-3 w-3 text-accent" aria-hidden="true" />
            </a>
          )}
        </div>
      </div>

      <!-- Minimalist Title & Lead -->
      <header class="mb-7">
        <h1
          transition:name={`project-title-${project.id}`}
          class="font-display text-2xl font-bold tracking-tight text-text-primary sm:text-4xl"
        >
          {project.title}
        </h1>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary sm:text-base">
          {project.summary}
        </p>

        <!-- Clean Inline Tags (Max 3 visible) -->
        <div class="mt-4 flex flex-wrap items-center gap-1.5">
          {allProjectTags.slice(0, 3).map((tagObj) => (
            <span class="rounded-[20px] border border-border-subtle bg-surface/60 px-2.5 py-0.5 font-mono text-[11px] text-text-secondary">
              <span class="text-accent">#</span>{tagObj!.label}
            </span>
          ))}
        </div>
      </header>

      <!-- Unobstructed Morphing Hero Banner Carousel -->
      <div
        transition:name={`project-banner-${project.id}`}
        class="group/banner relative aspect-[16/9] w-full overflow-hidden rounded-2xl border border-border-subtle bg-surface shadow-[0_20px_60px_rgba(0,0,0,0.65)]"
      >
        <img
          id="detail-hero-banner-img"
          src={project.image}
          alt={project.imageAlt}
          width="1200"
          height="675"
          fetchpriority="high"
          decoding="async"
          class="h-full w-full object-cover object-center transition-opacity duration-300"
        />

        {project.gallery && project.gallery.length > 1 && (
          <>
            <!-- Prev / Next Carousel Controls -->
            <button
              type="button"
              id="carousel-prev"
              aria-label={locale === 'en' ? 'Previous screenshot' : 'Captura anterior'}
              class="absolute top-1/2 left-3 -translate-y-1/2 inline-flex h-8 w-8 items-center justify-center rounded-full border border-border-subtle/80 bg-bg-base/80 text-text-primary opacity-0 backdrop-blur-md transition-all duration-200 group-hover/banner:opacity-100 hover:border-accent hover:text-accent cursor-pointer"
            >
              <ChevronLeft class="h-4 w-4" aria-hidden="true" />
            </button>
            <button
              type="button"
              id="carousel-next"
              aria-label={locale === 'en' ? 'Next screenshot' : 'Siguiente captura'}
              class="absolute top-1/2 right-3 -translate-y-1/2 inline-flex h-8 w-8 items-center justify-center rounded-full border border-border-subtle/80 bg-bg-base/80 text-text-primary opacity-0 backdrop-blur-md transition-all duration-200 group-hover/banner:opacity-100 hover:border-accent hover:text-accent cursor-pointer"
            >
              <ChevronRight class="h-4 w-4" aria-hidden="true" />
            </button>
          </>
        )}
      </div>

      <!-- Micro Thumbnails Strip (Ultra-compact) -->
      {project.gallery && project.gallery.length > 1 && (
        <div class="mt-2.5 flex items-center justify-between gap-3">
          <div class="flex items-center gap-2 overflow-x-auto py-0.5">
            {project.gallery.map((item, idx) => (
              <button
                type="button"
                data-gallery-item
                data-index={idx}
                data-src={item.src}
                data-alt={item.alt}
                data-title={item.title}
                title={item.title}
                aria-label={item.title}
                class:list={[
                  'relative h-10 w-16 shrink-0 cursor-pointer overflow-hidden rounded-lg border bg-bg-base transition-all duration-200 hover:opacity-100',
                  idx === 0
                    ? 'border-accent ring-1 ring-accent/40 opacity-100'
                    : 'border-border-subtle opacity-50',
                ]}
              >
                <img
                  src={item.src}
                  alt={item.alt}
                  width="160"
                  height="90"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover object-center"
                />
              </button>
            ))}
          </div>
          <span
            id="carousel-caption"
            class="hidden sm:inline-block truncate font-mono text-[11px] text-text-muted"
          >
            {project.gallery[0]?.title}
          </span>
        </div>
      )}

      <!-- Minimalist Editorial Details -->
      <div class="mt-10 grid grid-cols-1 gap-8 border-t border-border-subtle/60 pt-8 md:grid-cols-12">
        <!-- Left: Key Points -->
        <div class="md:col-span-8">
          <h2 class="font-mono text-[11px] font-semibold tracking-[0.18em] text-accent uppercase">
            {projectsSection.highlightsLabel}
          </h2>
          <ul class="mt-3 space-y-2.5">
            {project.highlights.map((item) => (
              <li class="flex items-start gap-2.5 text-sm leading-relaxed text-text-secondary">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Right: Stack -->
        <aside class="md:col-span-4 md:border-l md:border-border-subtle/50 md:pl-7">
          <h2 class="font-mono text-[11px] font-semibold tracking-[0.18em] text-text-secondary uppercase">
            {projectsSection.stackAriaLabel}
          </h2>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {project.stack.map((tech) => (
              <span class="rounded-md border border-border-subtle bg-surface/70 px-2.5 py-1 font-mono text-xs text-text-primary">
                {tech}
              </span>
            ))}
          </div>
        </aside>
      </div>
    </article>
  </main>

  <Contact locale={locale} />
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const heroImg = document.getElementById('detail-hero-banner-img') as HTMLImageElement | null;
    const captionEl = document.getElementById('carousel-caption');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');
    const galleryItems = Array.from(
      document.querySelectorAll<HTMLElement>('[data-gallery-item]'),
    );

    if (!heroImg || !galleryItems.length) return;

    let currentIndex = 0;

    const selectByIndex = (index: number) => {
      currentIndex = (index + galleryItems.length) % galleryItems.length;
      const item = galleryItems[currentIndex];
      if (!item) return;

      const nextSrc = item.getAttribute('data-src');
      const nextAlt = item.getAttribute('data-alt');
      const nextTitle = item.getAttribute('data-title');
      if (!nextSrc) return;

      heroImg.src = nextSrc;
      if (nextAlt) heroImg.alt = nextAlt;
      if (captionEl && nextTitle) captionEl.textContent = nextTitle;

      galleryItems.forEach((el, idx) => {
        const isCurrent = idx === currentIndex;
        el.classList.toggle('border-accent', isCurrent);
        el.classList.toggle('ring-1', isCurrent);
        el.classList.toggle('ring-accent/40', isCurrent);
        el.classList.toggle('opacity-100', isCurrent);
        el.classList.toggle('opacity-50', !isCurrent);
        el.classList.toggle('border-border-subtle', !isCurrent);
      });
    };

    galleryItems.forEach((item, idx) => {
      item.addEventListener('click', () => selectByIndex(idx));
    });

    prevBtn?.addEventListener('click', () => selectByIndex(currentIndex - 1));
    nextBtn?.addEventListener('click', () => selectByIndex(currentIndex + 1));
  });
</script>
