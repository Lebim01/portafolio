---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import Contact from './Contact.astro';
import { getPortfolioContent, type ProjectItem } from '../data/portfolio';
import type { Locale } from '../i18n/utils';
import {
  ArrowLeft,
  ArrowUpRight,
  Calendar,
  CheckCircle2,
  Cpu,
  Layers,
} from '@lucide/astro';

interface Props {
  locale: Locale;
  project: ProjectItem;
}

const { locale, project } = Astro.props;
const { siteMetadata, projectsSection, servicesSection } = getPortfolioContent(locale);

const tagLabelMap = new Map(
  servicesSection.tags.map((tag) => [tag.id, tag]),
);

const allProjectTags = [...project.industryTags, ...project.techTags]
  .map((id) => tagLabelMap.get(id))
  .filter(Boolean);

const backHref = locale === 'en' ? '/en#projects' : '/#projects';
const backLabel = locale === 'en' ? 'Back to projects' : 'Volver a proyectos';
const otherProjectsLabel = locale === 'en' ? 'Other projects' : 'Otros proyectos';
const getProjectUrl = (id: string) =>
  locale === 'en' ? `/en/projects/${id}` : `/proyectos/${id}`;

const otherProjects = projectsSection.items
  .filter((item) => item.id !== project.id)
  .slice(0, 3);

const siteOrigin = (Astro.site ?? new URL('https://victoralvarez.dev')).toString();
const canonicalPath = getProjectUrl(project.id);
const alternateEsPath = `/proyectos/${project.id}`;
const alternateEnPath = `/en/projects/${project.id}`;
const pageKeywords = [
  ...allProjectTags.map((t) => t!.label),
  ...project.stack,
  project.category,
];

const detailJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      '@id': new URL(canonicalPath, siteOrigin).toString(),
      name: project.title,
      applicationCategory: project.category,
      description: project.seoDescription,
      abstract: project.summary,
      image: {
        '@type': 'ImageObject',
        url: project.image,
        caption: project.imageAlt,
      },
      author: {
        '@type': 'Person',
        name: 'Victor Alvarez',
        jobTitle: siteMetadata.roleTitle,
      },
      featureList: project.highlights,
      keywords: pageKeywords.join(', '),
      operatingSystem: 'Web, Cloud, Distributed Infrastructure',
      inLanguage: locale,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: siteMetadata.brandName,
          item: new URL(locale === 'en' ? '/en' : '/', siteOrigin).toString(),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: project.title,
          item: new URL(canonicalPath, siteOrigin).toString(),
        },
      ],
    },
  ],
};
---

<Layout
  locale={locale}
  title={`${project.title} — ${siteMetadata.brandName}`}
  description={project.seoDescription}
  canonicalPath={canonicalPath}
  alternateEsPath={alternateEsPath}
  alternateEnPath={alternateEnPath}
  ogImage={project.image}
  ogImageAlt={project.imageAlt}
  ogType="article"
  keywords={pageKeywords}
  structuredData={detailJsonLd}
>
  <Navbar locale={locale} />

  <main id="main-content" class="pb-24 md:pb-32">
    <!-- Top Back Bar -->
    <div class="container-shell pt-6 pb-4">
      <a
        href={backHref}
        class="inline-flex items-center gap-2 rounded-[20px] border border-border-subtle bg-surface/80 px-3.5 py-1.5 font-mono text-xs font-medium text-text-secondary transition-all duration-200 hover:border-accent/60 hover:text-accent"
      >
        <ArrowLeft class="h-3.5 w-3.5 text-accent" aria-hidden="true" />
        <span>{backLabel}</span>
      </a>
    </div>

    <!-- Morphing Hero Banner (Card Image -> Full Detail Banner) -->
    <section class="container-shell">
      <div
        transition:name={`project-banner-${project.id}`}
        class="relative h-64 w-full overflow-hidden rounded-2xl border border-border-subtle bg-bg-base sm:h-80 md:h-[400px] shadow-[0_24px_70px_rgba(0,0,0,0.75)]"
      >
        <img
          src={project.image}
          alt={project.imageAlt}
          width="1200"
          height="630"
          fetchpriority="high"
          decoding="async"
          class="h-full w-full object-cover object-center opacity-80"
        />
        <div
          class="pointer-events-none absolute inset-0 bg-gradient-to-t from-bg-base via-bg-base/55 to-transparent"
          aria-hidden="true"
        />

        <!-- Banner Bottom Overlay Content -->
        <div class="absolute inset-x-0 bottom-0 p-6 sm:p-8 md:p-10">
          <div class="flex flex-wrap items-center gap-2.5 mb-3">
            <span
              transition:name={`project-date-${project.id}`}
              class="inline-flex items-center gap-1.5 rounded-[20px] border border-border-subtle bg-bg-base/90 px-3 py-1 font-mono text-xs font-medium text-text-primary backdrop-blur-md"
            >
              <Calendar class="h-3.5 w-3.5 text-accent" aria-hidden="true" />
              <span>{project.dateRange}</span>
            </span>

            <span class="rounded-[20px] border border-accent/40 bg-accent/15 px-3 py-1 font-mono text-xs font-semibold text-accent backdrop-blur-md">
              {project.statusLabel}
            </span>

            <span class="rounded-[20px] border border-border-subtle bg-surface/85 px-3 py-1 font-mono text-[11px] text-text-secondary backdrop-blur-md">
              {project.category}
            </span>
          </div>

          <h1
            transition:name={`project-title-${project.id}`}
            class="max-w-3xl font-display text-2xl font-bold tracking-tight text-text-primary sm:text-4xl md:text-5xl"
          >
            {project.title}
          </h1>
        </div>
      </div>
    </section>

    <!-- Detail Body Grid -->
    <section class="container-shell mt-10">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
        <!-- Main Column (8 cols) -->
        <div class="space-y-7 lg:col-span-8">
          <!-- Lead Summary -->
          <div class="rounded-2xl border border-border-subtle bg-surface/70 p-6 sm:p-7">
            <p class="text-base leading-relaxed text-text-primary/95 sm:text-lg">
              {project.summary}
            </p>
          </div>

          <!-- Key Implementation Highlights -->
          <div class="rounded-2xl border border-border-subtle bg-surface/70 p-6 sm:p-7">
            <h2 class="mb-4 font-mono text-xs font-semibold tracking-[0.18em] text-accent uppercase">
              {projectsSection.highlightsLabel}
            </h2>
            <ul class="space-y-3">
              {project.highlights.map((item) => (
                <li class="flex items-start gap-3 text-sm leading-relaxed text-text-secondary">
                  <CheckCircle2
                    class="mt-0.5 h-4 w-4 shrink-0 text-accent"
                    aria-hidden="true"
                  />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Architecture & System Design Notes -->
          <div class="rounded-2xl border border-border-subtle bg-surface/70 p-6 sm:p-7">
            <div class="mb-3 flex items-center gap-2 font-mono text-xs font-semibold tracking-[0.18em] text-accent uppercase">
              <Cpu class="h-4 w-4" aria-hidden="true" />
              <h2>{projectsSection.archSystemDesignLabel}</h2>
            </div>
            <p class="text-sm leading-relaxed text-text-secondary sm:text-base">
              {project.architectureNotes}
            </p>
          </div>
        </div>

        <!-- Sidebar Column (4 cols) -->
        <aside class="space-y-6 lg:col-span-4">
          <!-- Tags Box -->
          <div class="rounded-2xl border border-border-subtle bg-surface/70 p-6">
            <div class="mb-3 flex items-center gap-2 font-mono text-xs font-semibold tracking-wider text-text-secondary uppercase">
              <Layers class="h-3.5 w-3.5 text-accent" aria-hidden="true" />
              <span>{servicesSection.eyebrow}</span>
            </div>
            <div class="flex flex-wrap gap-1.5">
              {allProjectTags.map((tagObj) => (
                <span class="inline-flex items-center gap-1 rounded-[20px] border border-accent/35 bg-accent/10 px-3 py-1 font-mono text-xs font-medium text-accent">
                  <span>#</span>
                  <span>{tagObj!.label}</span>
                </span>
              ))}
            </div>
          </div>

          <!-- Tech Stack Box -->
          <div class="rounded-2xl border border-border-subtle bg-surface/70 p-6">
            <h2 class="mb-3 font-mono text-xs font-semibold tracking-wider text-text-secondary uppercase">
              {projectsSection.stackAriaLabel}
            </h2>
            <div class="flex flex-wrap gap-2">
              {project.stack.map((tech) => (
                <span class="rounded-lg border border-border-subtle bg-bg-base px-3 py-1.5 font-mono text-xs font-medium text-text-primary">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <!-- Direct Contact CTA Box -->
          <div class="spotlight-card corner-amber-glow p-6">
            <p class="font-display text-lg font-bold text-text-primary">
              {projectsSection.headerCtaLabel}
            </p>
            <p class="mt-1.5 text-xs leading-relaxed text-text-secondary">
              {locale === 'en'
                ? 'Want to build a similar architecture or integrate this system into your operation?'
                : '¿Buscas construir una arquitectura similar o integrar este tipo de sistema en tu operación?'}
            </p>
            <a
              href="#contact"
              class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-[20px] bg-accent px-4 py-2 text-xs font-bold tracking-wider text-bg-base uppercase shadow-[0_0_24px_rgba(245,158,11,0.3)] transition-all hover:bg-accent-hover"
            >
              <span>{projectsSection.inquireCtaLabel}</span>
              <ArrowUpRight class="h-3.5 w-3.5" aria-hidden="true" />
            </a>
          </div>
        </aside>
      </div>
    </section>

    <!-- Other Projects Navigation -->
    <section class="container-shell mt-16 border-t border-border-subtle/70 pt-12">
      <div class="mb-6 flex items-center justify-between">
        <h2 class="font-display text-xl font-bold text-text-primary">
          {otherProjectsLabel}
        </h2>
        <a
          href={backHref}
          class="font-mono text-xs font-semibold text-accent hover:underline"
        >
          {backLabel} →
        </a>
      </div>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {otherProjects.map((other) => (
          <a
            href={getProjectUrl(other.id)}
            class="spotlight-card group flex flex-col justify-between overflow-hidden transition-all duration-300 hover:-translate-y-1"
          >
            <div>
              <div
                transition:name={`project-banner-${other.id}`}
                class="relative aspect-[16/10] w-full overflow-hidden border-b border-border-subtle/80 bg-bg-base"
              >
                <img
                  src={other.image}
                  alt={other.imageAlt}
                  width="900"
                  height="563"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover object-center opacity-85 transition-all duration-500 group-hover:scale-105 group-hover:opacity-100"
                />
                <div
                  class="pointer-events-none absolute inset-0 bg-gradient-to-t from-bg-base via-bg-base/25 to-transparent"
                  aria-hidden="true"
                />
                <div class="absolute inset-x-3.5 bottom-2.5 flex items-center justify-between gap-2">
                  <span
                    transition:name={`project-date-${other.id}`}
                    class="inline-flex items-center gap-1.5 rounded-[20px] border border-border-subtle/80 bg-bg-base/85 px-2.5 py-0.5 font-mono text-[11px] font-medium text-text-secondary backdrop-blur-md"
                  >
                    <Calendar class="h-3 w-3 text-accent" aria-hidden="true" />
                    <span>{other.dateRange}</span>
                  </span>
                </div>
              </div>
              <div class="p-4">
                <h3
                  transition:name={`project-title-${other.id}`}
                  class="font-display text-base font-bold text-text-primary group-hover:text-accent line-clamp-1"
                >
                  {other.title}
                </h3>
                <p class="mt-1.5 line-clamp-2 text-xs text-text-secondary">
                  {other.summary}
                </p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Contact locale={locale} />
</Layout>

