---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Projects from './Projects.astro';
import Contact from './Contact.astro';
import type { Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Layout locale={locale}>
  <Navbar locale={locale} />
  <main id="main-content">
    <Hero locale={locale} />
    <About locale={locale} />
    <Projects locale={locale} />
  </main>
  <Contact locale={locale} />
</Layout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  document.addEventListener('astro:page-load', () => {
    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    // 1. Localized Spotlight Glow on Interactive Cards (Pointer devices only, rAF throttled)
    if (window.matchMedia('(pointer: fine)').matches) {
      const cards = document.querySelectorAll<HTMLElement>('.spotlight-card');
      cards.forEach((card) => {
        let rafId = 0;
        card.addEventListener(
          'pointermove',
          (event: PointerEvent) => {
            if (rafId) return;
            rafId = window.requestAnimationFrame(() => {
              const rect = card.getBoundingClientRect();
              card.style.setProperty('--mouse-x', `${event.clientX - rect.left}px`);
              card.style.setProperty('--mouse-y', `${event.clientY - rect.top}px`);
              rafId = 0;
            });
          },
          { passive: true }
        );
      });
    }

    // 2. GSAP Entrance & ScrollTrigger Reveals (Only on first fresh visit without hash, never when returning via "Volver a proyectos")
    const hasHash = Boolean(window.location.hash);
    const alreadyAnimated = sessionStorage.getItem('va_home_animated') === '1';

    if (!prefersReducedMotion && !hasHash && !alreadyAnimated) {
      sessionStorage.setItem('va_home_animated', '1');
      gsap.registerPlugin(ScrollTrigger);

      const heroTl = gsap.timeline({
        defaults: { ease: 'power3.out' },
      });

      heroTl.fromTo(
        '[data-hero-bg]',
        { opacity: 0 },
        { opacity: 1, duration: 0.4 },
        0
      );

      heroTl.fromTo(
        ['[data-hero-eyebrow]', '[data-hero-title]', '[data-hero-subtitle]', '[data-hero-desc]', '[data-hero-ctas]'],
        { opacity: 0, y: 12 },
        { opacity: 1, y: 0, duration: 0.38, stagger: 0.04 },
        0.04
      );

      heroTl.fromTo(
        '[data-hero-visual]',
        { opacity: 0 },
        { opacity: 1, duration: 0.4, clearProps: 'transform,scale' },
        0.08
      );

      heroTl.fromTo(
        '[data-hero-badge]',
        { opacity: 0, y: 8 },
        { opacity: 1, y: 0, duration: 0.32, stagger: 0.04, clearProps: 'transform,scale' },
        0.18
      );

      const revealElements = gsap.utils.toArray<HTMLElement>('[data-reveal]');
      revealElements.forEach((el) => {
        gsap.fromTo(
          el,
          { opacity: 0, y: 14 },
          {
            opacity: 1,
            y: 0,
            duration: 0.38,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: el,
              start: 'top 90%',
              toggleActions: 'play none none none',
              once: true,
            },
          }
        );
      });
    }
  });
</script>

