---
import { getPortfolioContent } from '../data/portfolio';
import type { Locale } from '../i18n/utils';
import {
  ArrowUpRight,
  CheckCircle2,
  ChevronDown,
} from '@lucide/astro';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? Astro.locals.locale ?? 'es';
const { projectsSection } = getPortfolioContent(locale);
const { items: featuredProjects } = projectsSection;
---

<section
  id="projects"
  aria-labelledby="projects-heading"
  class="relative py-20 md:py-28"
>
  <div class="section-divider mb-20 md:mb-28" aria-hidden="true"></div>

  <div class="container-shell">
    <!-- Section Header -->
    <div
      class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between"
      data-reveal
    >
      <div class="max-w-2xl">
        <div class="mb-3 inline-flex items-center gap-3 font-mono text-xs font-semibold tracking-[0.2em] text-accent uppercase">
          <span>{projectsSection.eyebrow}</span>
          <span class="h-[1px] w-8 bg-accent/70" aria-hidden="true"></span>
        </div>
        <h2
          id="projects-heading"
          class="font-display text-3xl font-bold tracking-tight text-text-primary sm:text-4xl"
        >
          {projectsSection.heading}
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary sm:text-base">
          {projectsSection.subtitle}
        </p>
      </div>

      <a
        href="#contact"
        class="inline-flex shrink-0 items-center gap-1.5 self-start rounded-[20px] border border-border-subtle bg-surface px-4 py-2 font-mono text-xs font-semibold tracking-wider text-text-primary uppercase transition-all duration-200 hover:border-accent/60 hover:text-accent md:self-auto"
      >
        <span>{projectsSection.headerCtaLabel}</span>
        <ArrowUpRight class="h-3.5 w-3.5 text-accent" aria-hidden="true" />
      </a>
    </div>

    <!-- Large Product Cards Grid -->
    <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-2">
      {
        featuredProjects.map((project, index) => (
          <article
            data-reveal
            class="spotlight-card group flex flex-col justify-between overflow-hidden"
          >
            <div class="relative z-10">
              <!-- High-Craft Product UI & Architecture Preview Window -->
              <div class="relative overflow-hidden border-b border-border-subtle bg-bg-base/90 p-5 sm:p-6">
                <!-- Window Top Bar -->
                <div class="mb-4 flex items-center justify-between gap-2">
                  <div class="flex items-center gap-2">
                    <span class="h-2.5 w-2.5 rounded-full bg-border-subtle transition-colors group-hover:bg-accent/80" />
                    <span class="h-2.5 w-2.5 rounded-full bg-border-subtle" />
                    <span class="h-2.5 w-2.5 rounded-full bg-border-subtle" />
                    <span class="ml-2 font-mono text-[11px] text-text-secondary">
                      {project.previewType === 'crypto-gateway' && 'tx-settlement-engine // evm-indexer'}
                      {project.previewType === 'vector-graph' && 'graphrag-query-planner // qdrant+neo4j'}
                      {project.previewType === 'saas-b2b' && 'tenant-control-plane // rbac-policy'}
                      {project.previewType === 'ai-pipeline' && 'ast-ingestion-worker // knowledge-graph'}
                    </span>
                  </div>
                  <span class="rounded-md border border-accent/30 bg-accent/10 px-2.5 py-0.5 font-mono text-[10px] font-semibold text-accent">
                    {project.category}
                  </span>
                </div>

                <!-- Product Visual Preview Canvas -->
                <div class="relative rounded-xl border border-border-subtle/90 bg-surface/90 p-4 transition-transform duration-300 group-hover:scale-[1.01]">
                  {project.previewType === 'crypto-gateway' && (
                    <div class="space-y-3 font-mono text-xs">
                      <div class="flex items-center justify-between border-b border-border-subtle/70 pb-2.5">
                        <span class="text-text-secondary">ORDER_STATE // ON-CHAIN VERIFIER</span>
                        <span class="inline-flex items-center gap-1.5 text-emerald-400">
                          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" />
                          CONFIRMED (12/12 BLOCKS)
                        </span>
                      </div>
                      <div class="grid grid-cols-3 gap-2.5">
                        <div class="rounded-lg border border-border-subtle bg-bg-base/80 p-2.5">
                          <span class="text-[10px] text-text-muted block">PROTOCOL</span>
                          <span class="text-text-primary font-semibold">EVM Multi-Chain</span>
                        </div>
                        <div class="rounded-lg border border-border-subtle bg-bg-base/80 p-2.5">
                          <span class="text-[10px] text-text-muted block">LEDGER MODE</span>
                          <span class="text-accent font-semibold">Double-Entry ACID</span>
                        </div>
                        <div class="rounded-lg border border-border-subtle bg-bg-base/80 p-2.5">
                          <span class="text-[10px] text-text-muted block">WEBHOOK</span>
                          <span class="text-emerald-400 font-semibold">HMAC-SHA256</span>
                        </div>
                      </div>
                      <div class="flex items-center justify-between rounded-lg bg-bg-base/60 px-3 py-2 text-[11px] text-text-secondary">
                        <span>event: InvoiceSettled(orderId, txHash, netAmount)</span>
                        <span class="text-accent">idempotent: true</span>
                      </div>
                    </div>
                  )}

                  {project.previewType === 'vector-graph' && (
                    <div class="space-y-3 font-mono text-xs">
                      <div class="flex items-center justify-between border-b border-border-subtle/70 pb-2.5">
                        <span class="text-text-secondary">HYBRID RETRIEVAL // DENSE + GRAPH</span>
                        <span class="text-accent">RRF FUSION SCORE</span>
                      </div>
                      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                        <div class="rounded-lg border border-border-subtle bg-bg-base/80 p-2.5">
                          <div class="flex items-center justify-between text-[10px] text-text-muted">
                            <span>VECTOR INDEX</span>
                            <span class="text-accent">COSINE SIM</span>
                          </div>
                          <p class="mt-1 text-text-primary font-semibold">HNSW High-Dim Embeddings</p>
                        </div>
                        <div class="rounded-lg border border-border-subtle bg-bg-base/80 p-2.5">
                          <div class="flex items-center justify-between text-[10px] text-text-muted">
                            <span>GRAPH TRAVERSAL</span>
                            <span class="text-emerald-400">2-HOP CYPHER</span>
                          </div>
                          <p class="mt-1 text-text-primary font-semibold">Entity &amp; Relation Context</p>
                        </div>
                      </div>
                      <div class="flex items-center justify-between rounded-lg bg-bg-base/60 px-3 py-2 text-[11px] text-text-secondary">
                        <span>pipeline: Query → Embed → Vector+Graph → Grounded Context</span>
                        <span class="text-accent">ACL Filtered</span>
                      </div>
                    </div>
                  )}

                  {project.previewType === 'saas-b2b' && (
                    <div class="space-y-3 font-mono text-xs">
                      <div class="flex items-center justify-between border-b border-border-subtle/70 pb-2.5">
                        <span class="text-text-secondary">MULTI-TENANT ISOLATION // B2B CORE</span>
                        <span class="text-emerald-400">RBAC ENFORCED</span>
                      </div>
                      <div class="grid grid-cols-3 gap-2.5">
                        <div class="rounded-lg border border-border-subtle bg-bg-base/80 p-2.5">
                          <span class="text-[10px] text-text-muted block">TENANCY</span>
                          <span class="text-text-primary font-semibold">Org-Scoped Context</span>
                        </div>
                        <div class="rounded-lg border border-border-subtle bg-bg-base/80 p-2.5">
                          <span class="text-[10px] text-text-muted block">WORKFLOWS</span>
                          <span class="text-accent font-semibold">Async Job Queues</span>
                        </div>
                        <div class="rounded-lg border border-border-subtle bg-bg-base/80 p-2.5">
                          <span class="text-[10px] text-text-muted block">AUDIT LOG</span>
                          <span class="text-text-primary font-semibold">Immutable Stream</span>
                        </div>
                      </div>
                      <div class="flex items-center justify-between rounded-lg bg-bg-base/60 px-3 py-2 text-[11px] text-text-secondary">
                        <span>scope: organization.permissions.verify(actor, resource)</span>
                        <span class="text-accent">Zero Trust</span>
                      </div>
                    </div>
                  )}

                  {project.previewType === 'ai-pipeline' && (
                    <div class="space-y-3 font-mono text-xs">
                      <div class="flex items-center justify-between border-b border-border-subtle/70 pb-2.5">
                        <span class="text-text-secondary">INCREMENTAL INGESTION // KNOWLEDGE HUB</span>
                        <span class="text-accent">AST + TAXONOMY</span>
                      </div>
                      <div class="grid grid-cols-3 gap-2.5">
                        <div class="rounded-lg border border-border-subtle bg-bg-base/80 p-2.5">
                          <span class="text-[10px] text-text-muted block">PARSER</span>
                          <span class="text-text-primary font-semibold">Semantic Chunking</span>
                        </div>
                        <div class="rounded-lg border border-border-subtle bg-bg-base/80 p-2.5">
                          <span class="text-[10px] text-text-muted block">SYNC MODE</span>
                          <span class="text-emerald-400 font-semibold">Delta Content Hash</span>
                        </div>
                        <div class="rounded-lg border border-border-subtle bg-bg-base/80 p-2.5">
                          <span class="text-[10px] text-text-muted block">OUTPUT</span>
                          <span class="text-accent font-semibold">JSON Schema + SSE</span>
                        </div>
                      </div>
                      <div class="flex items-center justify-between rounded-lg bg-bg-base/60 px-3 py-2 text-[11px] text-text-secondary">
                        <span>worker: DocumentDiff → GraphNodes → VectorUpsert</span>
                        <span class="text-accent">Streaming</span>
                      </div>
                    </div>
                  )}
                </div>
              </div>

              <!-- Project Body -->
              <div class="p-6 sm:p-7">
                <div class="flex items-center justify-between gap-2 text-xs text-text-secondary">
                  <span class="font-mono text-[11px] text-accent">
                    {project.statusLabel}
                  </span>
                </div>

                <h3 class="mt-2 font-display text-xl font-bold text-text-primary transition-colors group-hover:text-accent sm:text-2xl">
                  {project.title}
                </h3>

                <p class="mt-3 text-sm leading-relaxed text-text-secondary">
                  {project.summary}
                </p>

                <!-- Key Engineering Highlights -->
                <ul class="mt-5 space-y-2 border-t border-border-subtle/70 pt-4">
                  {project.highlights.map((item) => (
                    <li class="flex items-start gap-2.5 text-xs leading-relaxed text-text-secondary">
                      <CheckCircle2
                        class="mt-0.5 h-3.5 w-3.5 shrink-0 text-accent"
                        aria-hidden="true"
                      />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>

                <!-- Collapsible Architecture Deep-Dive -->
                <div class="mt-4">
                  <button
                    type="button"
                    data-arch-toggle={`arch-panel-${index}`}
                    aria-expanded="false"
                    aria-controls={`arch-panel-${index}`}
                    class="inline-flex items-center gap-1.5 font-mono text-xs font-medium text-text-primary/90 transition-colors hover:text-accent"
                  >
                    <span>{projectsSection.archToggleLabel}</span>
                    <ChevronDown
                      data-arch-chevron
                      class="h-3.5 w-3.5 text-accent transition-transform duration-200"
                      aria-hidden="true"
                    />
                  </button>
                  <div
                    id={`arch-panel-${index}`}
                    class="mt-2.5 hidden rounded-lg border border-border-subtle bg-bg-base/75 p-3.5 text-xs leading-relaxed text-text-secondary"
                  >
                    <p class="font-mono text-[10px] font-semibold text-accent uppercase mb-1">
                      {projectsSection.archSystemDesignLabel}
                    </p>
                    <p>{project.architectureNotes}</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Stack Tags & Details Link -->
            <div class="relative z-10 flex flex-wrap items-center justify-between gap-4 border-t border-border-subtle/80 bg-bg-base/40 px-6 py-4 sm:px-7">
              <div class="flex flex-wrap gap-1.5" aria-label={projectsSection.stackAriaLabel}>
                {project.stack.map((tech) => (
                  <span class="rounded-md border border-border-subtle bg-surface px-2.5 py-1 font-mono text-[11px] font-medium text-text-secondary transition-colors group-hover:border-accent/30 group-hover:text-text-primary">
                    {tech}
                  </span>
                ))}
              </div>

              <a
                href={project.detailsAnchor ?? '#contact'}
                class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-[20px] border border-border-subtle bg-surface text-text-secondary transition-all duration-200 hover:border-accent hover:bg-accent hover:text-bg-base"
                aria-label={`${projectsSection.detailsAriaPrefix} ${project.title}`}
                title={`${projectsSection.detailsAriaPrefix} ${project.title}`}
              >
                <ArrowUpRight class="h-3.5 w-3.5" aria-hidden="true" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const archButtons = document.querySelectorAll<HTMLButtonElement>('[data-arch-toggle]');

  archButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-arch-toggle');
      if (!targetId) return;
      const panel = document.getElementById(targetId);
      const chevron = btn.querySelector('[data-arch-chevron]');
      if (!panel) return;

      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      panel.classList.toggle('hidden', isExpanded);
      chevron?.classList.toggle('rotate-180', !isExpanded);
    });
  });
</script>
