---
import { getPortfolioContent, type ProjectItem } from '../data/portfolio';
import type { Locale } from '../i18n/utils';
import Services from './Services.astro';
import {
  ArrowUpRight,
  Calendar,
} from '@lucide/astro';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? Astro.locals.locale ?? 'es';
const { projectsSection, servicesSection } = getPortfolioContent(locale);

// Block 1: The 6 flagship engineering & architecture case studies
const FLAGSHIP_IDS = [
  'blue-castle-ventures',
  'node-payments-crypto-gateway',
  'voltz-b2b-marketplace',
  'cicada-institutional-trading',
  'nodeworkforce-ai-agents-saas',
  'cococo-ventures',
];

const flagshipProjects = FLAGSHIP_IDS.map((id) =>
  projectsSection.items.find((p) => p.id === id),
).filter((p): p is ProjectItem => Boolean(p));

// Block 2: Full catalog
const allProjects = projectsSection.items;

const getRoleGroups = (role: string): string[] => {
  const r = role.toLowerCase();
  const groups: string[] = [];
  if (r.includes('founder')) groups.push('role-founder');
  if (r.includes('cto')) groups.push('role-cto');
  if (
    r.includes('principal') ||
    r.includes('lead') ||
    r.includes('senior') ||
    r.includes('consult')
  ) {
    groups.push('role-lead');
  }
  return groups;
};

const tagLabelMap = new Map(
  servicesSection.tags.map((tag) => [tag.id, tag]),
);

const getProjectUrl = (id: string) =>
  locale === 'en' ? `/en/projects/${id}` : `/proyectos/${id}`;

const block1Eyebrow =
  locale === 'en' ? 'FLAGSHIP CASE STUDIES (6)' : 'CASOS PRINCIPALES DE ARQUITECTURA (6)';
const block1Heading =
  locale === 'en'
    ? 'Featured Engineering & Architecture'
    : 'Ingeniería y arquitectura destacada';
const block1Subtitle =
  locale === 'en'
    ? '6 selected cases showcasing executive ownership, technical complexity, and measurable business results.'
    : '6 casos seleccionados con responsabilidad directa, dificultad técnica y resultados reales en producción.';
---

<section
  id="projects"
  aria-labelledby="projects-heading"
  class="relative pt-16 pb-28 md:pt-24 md:pb-36"
>
  <div class="section-divider mb-14 md:mb-16" aria-hidden="true"></div>

  <div class="container-shell">
    <!-- =================================================================== -->
    <!-- PRIMER BLOQUE: INGENIERÍA Y ARQUITECTURA DESTACADA (6 CASOS CLAVE) -->
    <!-- =================================================================== -->
    <div class="max-w-2xl" data-reveal>
      <div class="mb-2 inline-flex items-center gap-3 font-mono text-xs font-semibold tracking-[0.2em] text-accent uppercase">
        <span>{block1Eyebrow}</span>
        <span class="h-[1px] w-8 bg-accent/70" aria-hidden="true"></span>
      </div>
      <h2
        id="projects-heading"
        class="font-display text-2xl font-bold tracking-tight text-text-primary sm:text-4xl"
      >
        {block1Heading}
      </h2>
      <p class="mt-2 text-xs leading-relaxed text-text-secondary sm:text-sm">
        {block1Subtitle}
      </p>
    </div>

    <!-- 6 Flagship Case Study Cards -->
    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        flagshipProjects.map((project) => {
          const projectHref = getProjectUrl(project.id);
          const previewSlide = project.gallery?.find(
            (slide) => slide.src !== project.image,
          );
          const hasHoverPreview = Boolean(previewSlide);
          const [rawBrand, ...restTitle] = project.title.split(':');
          const brandName = rawBrand?.trim() || project.title;
          const appType = restTitle.join(':').trim() || project.category;

          return (
            <a
              href={projectHref}
              data-astro-prefetch
              data-reveal
              aria-label={`${project.title} — ${project.seoDescription}`}
              title={`${project.title} (${project.dateRange})`}
              class="spotlight-card corner-amber-glow group flex flex-col justify-between overflow-hidden border-accent/25 transition-all duration-300 hover:-translate-y-1 hover:border-accent/60 focus-visible:outline-2 focus-visible:outline-accent"
            >
              <div>
                <!-- Visual Cover + Screenshot Hover Preview -->
                <div class="relative aspect-[16/10] w-full overflow-hidden border-b border-border-subtle/80 bg-[radial-gradient(circle_at_center,rgba(59,130,246,0.22),rgba(9,11,18,0.98)_76%)]">
                  {previewSlide && (
                    <>
                      <img
                        src={previewSlide.src}
                        alt={previewSlide.alt}
                        title={previewSlide.title}
                        width="900"
                        height="563"
                        loading="lazy"
                        decoding="async"
                        class="pointer-events-none absolute inset-0 h-full w-full scale-[1.04] object-cover object-top opacity-20 blur-[2px] transition-all duration-500 ease-out group-hover:scale-100 group-hover:opacity-100 group-hover:blur-0"
                      />
                      <div
                        class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(9,11,18,0.52),rgba(9,11,18,0.9)_85%)] transition-opacity duration-500 group-hover:opacity-10"
                        aria-hidden="true"
                      />
                    </>
                  )}

                  <div
                    class:list={[
                      'relative z-[1] flex h-full w-full items-center justify-center transition-all duration-500 ease-out',
                      hasHoverPreview
                        ? 'group-hover:scale-90 group-hover:opacity-0'
                        : 'group-hover:scale-105',
                    ]}
                  >
                    {project.imageBg === 'light' ? (
                      <div class="flex max-h-[62%] max-w-[76%] items-center justify-center rounded-2xl border border-white/80 bg-[radial-gradient(circle_at_center,#FFFFFF_55%,#F1F5F9_100%)] px-6 py-4 shadow-[0_16px_38px_rgba(0,0,0,0.55)]">
                        <img
                          src={project.image}
                          alt={project.imageAlt}
                          title={project.title}
                          width="900"
                          height="563"
                          loading="lazy"
                          decoding="async"
                          class="max-h-16 w-auto max-w-full object-contain"
                        />
                      </div>
                    ) : (
                      <img
                        src={project.image}
                        alt={project.imageAlt}
                        title={project.title}
                        width="900"
                        height="563"
                        loading="lazy"
                        decoding="async"
                        class:list={[
                          'h-full w-full object-center',
                          project.imageFit === 'contain'
                            ? 'object-contain p-6 opacity-95 drop-shadow-[0_14px_30px_rgba(37,99,235,0.38)]'
                            : 'object-cover opacity-90',
                        ]}
                      />
                    )}
                  </div>

                  <div
                    class="pointer-events-none absolute inset-0 z-[2] bg-gradient-to-t from-bg-base via-bg-base/20 to-transparent"
                    aria-hidden="true"
                  />

                  <div class="absolute top-2.5 left-3.5 z-[3]">
                    <span class="inline-flex items-center gap-1.5 rounded-[20px] border border-accent/60 bg-bg-base/90 px-2.5 py-0.5 font-mono text-[10px] font-semibold tracking-wider text-accent uppercase backdrop-blur-md">
                      <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
                      <span>{project.role}</span>
                    </span>
                  </div>

                  <div class="absolute inset-x-3.5 bottom-2.5 z-[3] flex items-center justify-between gap-2">
                    <span class="inline-flex items-center gap-1.5 rounded-[20px] border border-border-subtle/80 bg-bg-base/85 px-2.5 py-0.5 font-mono text-[11px] font-medium text-text-secondary backdrop-blur-md">
                      <Calendar class="h-3 w-3 text-accent" aria-hidden="true" />
                      <span>{project.dateRange}</span>
                    </span>

                    <span class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-border-subtle/80 bg-bg-base/85 text-text-secondary backdrop-blur-md transition-colors duration-200 group-hover:border-accent group-hover:bg-accent group-hover:text-bg-base">
                      <ArrowUpRight class="h-3.5 w-3.5" aria-hidden="true" />
                    </span>
                  </div>
                </div>

                <!-- Card Body: 1. Nombre de Empresa -> 2. Tipo de Aplicación -> 3. Resumen Resultado -->
                <div class="p-4 sm:p-5">
                  <h3 class="font-display text-lg font-bold leading-snug text-text-primary transition-colors group-hover:text-accent sm:text-xl line-clamp-1">
                    {brandName}
                  </h3>
                  <p class="mt-1 font-mono text-[11px] font-medium tracking-wider text-accent uppercase line-clamp-1">
                    {appType}
                  </p>

                  <p class="mt-2.5 line-clamp-3 text-xs leading-relaxed text-text-secondary sm:text-[13px]">
                    {project.ownership.productImpact}
                  </p>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>

    <!-- =================================================================== -->
    <!-- SEGUNDO BLOQUE: EXPLORAR TODOS MIS PROYECTOS (FILTROS + CATÁLOGO)   -->
    <!-- =================================================================== -->
    <div class="mt-20 md:mt-28">
      <Services locale={locale} />

      <div
        id="projects-empty-state"
        class="mt-8 hidden rounded-2xl border border-dashed border-border-subtle bg-surface/40 p-10 text-center font-mono text-xs text-text-secondary"
      >
        {projectsSection.emptyFilterText}
      </div>

      <div
        id="projects-grid"
        class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"
      >
        {
          allProjects.map((project) => {
            const filterTokens = [
              ...project.industryTags,
              ...project.techTags,
              ...getRoleGroups(project.role),
            ];
            const visibleTags = project.industryTags
              .map((id) => tagLabelMap.get(id))
              .filter(Boolean)
              .slice(0, 3);
            const projectHref = getProjectUrl(project.id);
            const previewSlide = project.gallery?.find(
              (slide) => slide.src !== project.image,
            );
            const hasHoverPreview = Boolean(previewSlide);
            const isFlagship = FLAGSHIP_IDS.includes(project.id);

            return (
              <a
                href={projectHref}
                data-astro-prefetch
                data-reveal
                data-project-card
                data-project-tags={JSON.stringify(filterTokens)}
                aria-label={`${project.title} — ${project.seoDescription}`}
                title={`${project.title} (${project.dateRange})`}
                itemscope
                itemtype="https://schema.org/SoftwareApplication"
                class="spotlight-card group flex flex-col justify-between overflow-hidden transition-all duration-300 hover:-translate-y-1 focus-visible:outline-2 focus-visible:outline-accent"
              >
                <meta itemprop="applicationCategory" content={project.category} />
                <meta itemprop="keywords" content={[...project.industryTags, ...project.stack].join(', ')} />
                <div>
                  <div
                    class="relative aspect-[16/10] w-full overflow-hidden border-b border-border-subtle/80 bg-[radial-gradient(circle_at_center,rgba(59,130,246,0.22),rgba(9,11,18,0.98)_76%)]"
                  >
                    {previewSlide && (
                      <>
                        <img
                          src={previewSlide.src}
                          alt={previewSlide.alt}
                          title={previewSlide.title}
                          width="900"
                          height="563"
                          loading="lazy"
                          decoding="async"
                          class="pointer-events-none absolute inset-0 h-full w-full scale-[1.04] object-cover object-top opacity-20 blur-[2px] transition-all duration-500 ease-out group-hover:scale-100 group-hover:opacity-100 group-hover:blur-0"
                        />
                        <div
                          class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(9,11,18,0.52),rgba(9,11,18,0.9)_85%)] transition-opacity duration-500 group-hover:opacity-10"
                          aria-hidden="true"
                        />
                      </>
                    )}

                    <div
                      class:list={[
                        'relative z-[1] flex h-full w-full items-center justify-center transition-all duration-500 ease-out',
                        hasHoverPreview
                          ? 'group-hover:scale-90 group-hover:opacity-0'
                          : 'group-hover:scale-105',
                      ]}
                    >
                      {project.imageBg === 'light' ? (
                        <div class="flex max-h-[62%] max-w-[76%] items-center justify-center rounded-2xl border border-white/80 bg-[radial-gradient(circle_at_center,#FFFFFF_55%,#F1F5F9_100%)] px-6 py-4 shadow-[0_16px_38px_rgba(0,0,0,0.55)]">
                          <img
                            src={project.image}
                            alt={project.imageAlt}
                            title={project.title}
                            width="900"
                            height="563"
                            loading="lazy"
                            decoding="async"
                            itemprop="image"
                            class="max-h-16 w-auto max-w-full object-contain"
                          />
                        </div>
                      ) : (
                        <img
                          src={project.image}
                          alt={project.imageAlt}
                          title={project.title}
                          width="900"
                          height="563"
                          loading="lazy"
                          decoding="async"
                          itemprop="image"
                          class:list={[
                            'h-full w-full object-center',
                            project.imageFit === 'contain'
                              ? 'object-contain p-6 opacity-95 drop-shadow-[0_14px_30px_rgba(37,99,235,0.38)]'
                              : 'object-cover opacity-90',
                          ]}
                        />
                      )}
                    </div>

                    <div
                      class="pointer-events-none absolute inset-0 z-[2] bg-gradient-to-t from-bg-base via-bg-base/20 to-transparent"
                      aria-hidden="true"
                    />

                    {isFlagship && (
                      <div class="absolute top-2.5 left-3.5 z-[3]">
                        <span class="inline-flex items-center gap-1.5 rounded-[20px] border border-accent/60 bg-bg-base/90 px-2.5 py-0.5 font-mono text-[10px] font-semibold tracking-wider text-accent uppercase backdrop-blur-md">
                          <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
                          <span>{locale === 'en' ? 'Flagship' : 'Destacado'}</span>
                        </span>
                      </div>
                    )}

                    <div class="absolute inset-x-3.5 bottom-2.5 z-[3] flex items-center justify-between gap-2">
                      <span
                        class="inline-flex items-center gap-1.5 rounded-[20px] border border-border-subtle/80 bg-bg-base/85 px-2.5 py-0.5 font-mono text-[11px] font-medium text-text-secondary backdrop-blur-md"
                      >
                        <Calendar class="h-3 w-3 text-accent" aria-hidden="true" />
                        <span>{project.dateRange}</span>
                      </span>

                      <span class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-border-subtle/80 bg-bg-base/85 text-text-secondary backdrop-blur-md transition-colors duration-200 group-hover:border-accent group-hover:bg-accent group-hover:text-bg-base">
                        <ArrowUpRight class="h-3.5 w-3.5" aria-hidden="true" />
                      </span>
                    </div>
                  </div>

                  <div class="p-4 sm:p-5">
                    <p class="mb-1 font-mono text-[10px] font-semibold tracking-wider text-accent uppercase line-clamp-1">
                      {project.role}
                    </p>
                    <h3
                      itemprop="name"
                      class="font-display text-base font-bold leading-snug text-text-primary transition-colors group-hover:text-accent sm:text-lg line-clamp-1"
                    >
                      {project.title}
                    </h3>

                    <p
                      itemprop="description"
                      class="mt-2 line-clamp-3 text-xs leading-relaxed text-text-secondary sm:text-[13px]"
                    >
                      {project.summary}
                    </p>
                  </div>
                </div>

                <div class="flex flex-nowrap items-center gap-1.5 overflow-hidden border-t border-border-subtle/60 px-4 py-3 sm:px-5">
                  {visibleTags.map((tagObj) => (
                    <span class="inline-flex min-w-0 items-center gap-0.5 whitespace-nowrap rounded-[20px] border border-border-subtle bg-bg-base/75 px-2 py-0.5 font-mono text-[10px] font-medium text-text-secondary transition-colors group-hover:border-accent/35 group-hover:text-text-primary">
                      <span class="shrink-0 text-accent">#</span>
                      <span class="truncate">{tagObj!.label}</span>
                    </span>
                  ))}
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<script>
  function initProjectFilters() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter-tag]');
    const projectCards = document.querySelectorAll<HTMLElement>('[data-project-card]');
    const clearFilterBtn = document.getElementById('clear-project-filter');
    const emptyState = document.getElementById('projects-empty-state');

    if (!filterButtons.length || !projectCards.length) return;

    let activeTag = 'all';

    function applyFilter(nextTag: string) {
      activeTag = activeTag === nextTag && nextTag !== 'all' ? 'all' : nextTag;

      filterButtons.forEach((btn) => {
        const btnTag = btn.getAttribute('data-filter-tag');
        const isSelected = btnTag === activeTag;
        btn.setAttribute('aria-pressed', String(isSelected));

        if (isSelected) {
          btn.classList.add('border-accent', 'bg-accent/15', 'text-accent');
          btn.classList.remove('border-border-subtle', 'bg-bg-base/75', 'text-text-secondary');
        } else {
          btn.classList.remove('border-accent', 'bg-accent/15', 'text-accent');
          btn.classList.add('border-border-subtle', 'bg-bg-base/75', 'text-text-secondary');
        }
      });

      if (clearFilterBtn) {
        clearFilterBtn.classList.toggle('hidden', activeTag === 'all');
        clearFilterBtn.classList.toggle('inline-flex', activeTag !== 'all');
      }

      let visibleCount = 0;
      projectCards.forEach((card) => {
        const rawTags = card.getAttribute('data-project-tags');
        const tags: string[] = rawTags ? JSON.parse(rawTags) : [];
        const matches = activeTag === 'all' || tags.includes(activeTag);

        card.classList.toggle('hidden', !matches);
        if (matches) visibleCount += 1;
      });

      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCount > 0);
      }
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.getAttribute('data-filter-tag') ?? 'all';
        applyFilter(tag);
      });
    });

    clearFilterBtn?.addEventListener('click', () => {
      applyFilter('all');
    });
  }

  document.addEventListener('astro:page-load', initProjectFilters);
</script>
