---
import { getPortfolioContent } from '../data/portfolio';
import type { Locale } from '../i18n/utils';
import { Menu, X, ArrowUpRight, Terminal, Globe } from '@lucide/astro';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? Astro.locals.locale ?? 'es';
const { navigationItems, siteMetadata, navbar } = getPortfolioContent(locale);
const homeBase = locale === 'en' ? '/en' : '/';
const resolveNavHref = (href: string) =>
  href.startsWith('#') && href !== '#contact' ? `${homeBase}${href}` : href;
---

<header
  id="site-header"
  data-open-aria={navbar.openMenuAria}
  data-close-aria={navbar.closeMenuAria}
  class="sticky top-0 z-50 w-full border-b border-transparent transition-colors duration-300"
>
  <div class="container-shell flex h-20 items-center justify-between gap-4">
    <!-- Brand Identity -->
    <a
      href={`${homeBase}#hero`}
      class="group flex items-center gap-3 text-text-primary focus-visible:rounded-md"
      aria-label={`${siteMetadata.brandName} — ${navigationItems[0]?.label}`}
    >
      <span
        class="flex h-10 w-10 items-center justify-center rounded-lg border border-accent/40 bg-surface text-accent shadow-[0_0_20px_rgba(245,158,11,0.16)] transition-transform duration-300 group-hover:scale-105 group-hover:border-accent"
      >
        <Terminal class="h-5 w-5" aria-hidden="true" />
      </span>
      <div class="flex flex-col">
        <span class="font-display text-base font-bold tracking-wider text-text-primary">
          VICTOR<span class="text-accent">ALVAREZ</span>
        </span>
        <span class="font-mono text-[10px] tracking-widest text-text-secondary uppercase">
          {navbar.subtitle}
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav aria-label={navbar.mainNavAria} class="hidden lg:block">
      <ul class="flex items-center gap-1 xl:gap-2">
        {
          navigationItems.map((item, idx) => (
            <li>
              <a
                href={resolveNavHref(item.href)}
                data-nav-link={item.href.replace('#', '')}
                class:list={[
                  'nav-link relative inline-flex items-center px-3.5 py-2 text-xs font-medium tracking-wider uppercase transition-colors duration-200 rounded-md',
                  idx === 0
                    ? 'text-accent'
                    : 'text-text-secondary hover:text-text-primary',
                ]}
              >
                {item.label}
                <span
                  data-nav-indicator
                  class:list={[
                    'nav-indicator absolute bottom-0.5 left-3.5 right-3.5 h-0.5 rounded-full bg-accent transition-all duration-300',
                    idx === 0 ? 'opacity-100 scale-x-100' : 'opacity-0 scale-x-0',
                  ]}
                />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Right Action, SSR Language Switcher & Mobile Trigger -->
    <div class="flex items-center gap-2.5 sm:gap-3">
      <!-- SSR Language Switcher (ES / EN) -->
      <div
        role="group"
        aria-label={navbar.langSwitchAria}
        class="inline-flex items-center rounded-[20px] border border-border-subtle bg-surface/90 p-0.5 text-xs font-mono"
      >
        <Globe class="ml-2 mr-1 h-3.5 w-3.5 text-accent hidden sm:inline-block" aria-hidden="true" />
        <a
          href="/?lang=es"
          data-lang-switch="es"
          hreflang="es"
          aria-current={locale === 'es' ? 'page' : undefined}
          class:list={[
            'rounded-[20px] px-2 py-0.5 text-[11px] font-semibold uppercase transition-all duration-200',
            locale === 'es'
              ? 'bg-accent text-bg-base shadow-[0_0_12px_rgba(245,158,11,0.3)]'
              : 'text-text-secondary hover:text-text-primary',
          ]}
        >
          ES
        </a>
        <a
          href="/en?lang=en"
          data-lang-switch="en"
          hreflang="en"
          aria-current={locale === 'en' ? 'page' : undefined}
          class:list={[
            'rounded-[20px] px-2 py-0.5 text-[11px] font-semibold uppercase transition-all duration-200',
            locale === 'en'
              ? 'bg-accent text-bg-base shadow-[0_0_12px_rgba(245,158,11,0.3)]'
              : 'text-text-secondary hover:text-text-primary',
          ]}
        >
          EN
        </a>
      </div>

      <a
        href="#contact"
        class="hidden sm:inline-flex items-center gap-1.5 rounded-[20px] border border-accent/60 bg-accent/10 px-3.5 py-1.5 text-xs font-semibold tracking-wider text-text-primary uppercase transition-all duration-200 hover:border-accent hover:bg-accent hover:text-bg-base hover:shadow-[0_0_24px_rgba(245,158,11,0.35)] active:scale-[0.98]"
      >
        <span>{navbar.ctaLabel}</span>
        <ArrowUpRight class="h-3.5 w-3.5" aria-hidden="true" />
      </a>

      <button
        id="mobile-menu-btn"
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center rounded-[20px] border border-border-subtle bg-surface text-text-primary transition-colors hover:border-accent/50 hover:text-accent lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu-panel"
        aria-label={navbar.openMenuAria}
      >
        <Menu id="menu-icon-open" class="h-5 w-5" aria-hidden="true" />
        <X id="menu-icon-close" class="hidden h-5 w-5" aria-hidden="true" />
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div
    id="mobile-menu-panel"
    class="hidden border-b border-border-subtle bg-bg-base/95 backdrop-blur-xl lg:hidden"
    role="region"
    aria-label={navbar.mobileNavAria}
  >
    <nav class="container-shell py-5" aria-label={navbar.mobileNavAria}>
      <ul class="flex flex-col gap-1.5">
        {
          navigationItems.map((item) => (
            <li>
              <a
                href={resolveNavHref(item.href)}
                data-mobile-link
                class="flex min-h-[44px] items-center justify-between rounded-lg px-4 py-2.5 text-sm font-medium text-text-secondary transition-colors hover:bg-surface hover:text-accent"
              >
                <span>{item.label}</span>
                <span class="font-mono text-xs text-text-muted">→</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-4 border-t border-border-subtle pt-4">
        <a
          href="#contact"
          data-mobile-link
          class="flex w-full items-center justify-center gap-2 rounded-[20px] bg-accent px-4 py-2 text-xs font-semibold tracking-wider text-bg-base uppercase transition-transform active:scale-[0.99]"
        >
          <span>{navbar.mobileCtaLabel}</span>
          <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const header = document.getElementById('site-header');
    const menuBtn = document.getElementById('mobile-menu-btn');
    const menuPanel = document.getElementById('mobile-menu-panel');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
    const mobileLinks = document.querySelectorAll<HTMLAnchorElement>('[data-mobile-link]');
    const langSwitchLinks = document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]');

    const openAria = header?.dataset.openAria ?? 'Open menu';
    const closeAria = header?.dataset.closeAria ?? 'Close menu';

    // Preserve current section hash when switching language
    langSwitchLinks.forEach((link) => {
      link.addEventListener('click', () => {
        const targetLang = link.getAttribute('data-lang-switch');
        if (targetLang) {
          document.cookie = `va_locale=${targetLang}; path=/; max-age=31536000; samesite=lax`;
        }
        if (window.location.hash) {
          const baseHref = link.getAttribute('href')?.split('#')[0] ?? '/';
          link.setAttribute('href', `${baseHref}${window.location.hash}`);
        }
      });
    });

    // Sticky Header Transition on Scroll
    const updateHeaderStyle = () => {
      if (!header) return;
      if (window.scrollY > 16) {
        header.classList.add(
          'bg-bg-base/90',
          'backdrop-blur-md',
          'border-border-subtle',
          'shadow-[0_10px_30px_-10px_rgba(0,0,0,0.6)]'
        );
        header.classList.remove('border-transparent');
      } else {
        header.classList.remove(
          'bg-bg-base/90',
          'backdrop-blur-md',
          'border-border-subtle',
          'shadow-[0_10px_30px_-10px_rgba(0,0,0,0.6)]'
        );
        header.classList.add('border-transparent');
      }
    };

    updateHeaderStyle();
    window.addEventListener('scroll', updateHeaderStyle, { passive: true });

    // Mobile Menu Toggle & Accessibility
    const setMobileMenuOpen = (isOpen: boolean) => {
      if (!menuBtn || !menuPanel || !iconOpen || !iconClose) return;
      menuBtn.setAttribute('aria-expanded', String(isOpen));
      menuBtn.setAttribute('aria-label', isOpen ? closeAria : openAria);
      menuPanel.classList.toggle('hidden', !isOpen);
      iconOpen.classList.toggle('hidden', isOpen);
      iconClose.classList.toggle('hidden', !isOpen);
    };

    menuBtn?.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      setMobileMenuOpen(!isExpanded);
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => setMobileMenuOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuBtn?.getAttribute('aria-expanded') === 'true') {
        setMobileMenuOpen(false);
        menuBtn.focus();
      }
    });

    // Active Section Indicator via IntersectionObserver
    const setActiveNav = (sectionId: string) => {
      navLinks.forEach((link) => {
        const target = link.getAttribute('data-nav-link');
        const indicator = link.querySelector('[data-nav-indicator]');
        const isActive = target === sectionId;

        link.classList.toggle('text-accent', isActive);
        link.classList.toggle('text-text-secondary', !isActive);
        if (isActive) {
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }

        if (indicator) {
          indicator.classList.toggle('opacity-100', isActive);
          indicator.classList.toggle('scale-x-100', isActive);
          indicator.classList.toggle('opacity-0', !isActive);
          indicator.classList.toggle('scale-x-0', !isActive);
        }
      });
    };

    const sections = document.querySelectorAll<HTMLElement>('section[id]');
    if ('IntersectionObserver' in window && sections.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && entry.target.id) {
              setActiveNav(entry.target.id);
            }
          });
        },
        {
          rootMargin: '-25% 0px -60% 0px',
          threshold: 0,
        }
      );

      sections.forEach((section) => observer.observe(section));
    }
  });
</script>
