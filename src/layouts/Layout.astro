---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import spaceGroteskWoff2 from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { getPortfolioContent } from '../data/portfolio';
import { getAlternateLinks, type Locale } from '../i18n/utils';

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
}

const locale: Locale = Astro.props.locale ?? Astro.locals.locale ?? 'es';
Astro.response.headers.set('Content-Language', locale);
Astro.response.headers.set('Vary', 'Accept-Language, Cookie');
const content = getPortfolioContent(locale);
const { siteMetadata, ogLocale } = content;

const {
  title = `${siteMetadata.brandName} — ${siteMetadata.roleTitle}`,
  description = siteMetadata.description,
} = Astro.props;

const siteOrigin = (Astro.site ?? new URL('https://victoralvarez.dev')).toString();
const canonicalPath = locale === 'en' ? '/en' : '/';
const canonicalURL = new URL(canonicalPath, siteOrigin);
const alternates = getAlternateLinks(siteOrigin);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Victor Alvarez',
  jobTitle: siteMetadata.roleTitle,
  description: siteMetadata.description,
  url: canonicalURL.toString(),
  inLanguage: locale,
  knowsAbout: [
    'Full-Stack Software Engineering',
    'Distributed Systems Architecture',
    'SaaS & B2B Platforms',
    'Blockchain & Crypto Payment Infrastructure',
    'Artificial Intelligence & Vector Search',
    'Graph Databases & GraphRAG',
    'Technical Leadership',
  ],
};
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0A0E13" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Preload critical local WOFF2 variable fonts -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={interWoff2}
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={spaceGroteskWoff2}
      crossorigin="anonymous"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Victor Alvarez" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL.toString()} />

    <!-- i18n SEO Alternate Links (Hreflang) -->
    <link rel="alternate" hreflang="es" href={alternates.es} />
    <link rel="alternate" hreflang="en" href={alternates.en} />
    <link rel="alternate" hreflang="x-default" href={alternates.xDefault} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:site_name" content={siteMetadata.brandName} />
    <meta property="og:locale" content={ogLocale} />
    <meta
      property="og:locale:alternate"
      content={locale === 'es' ? 'en_US' : 'es_ES'}
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-bg-base text-text-primary antialiased selection:bg-accent/25 selection:text-text-primary">
    <!-- Accessible Skip Navigation Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-bg-base focus:shadow-lg"
    >
      {siteMetadata.skipToContent}
    </a>

    <slot />
  </body>
</html>
